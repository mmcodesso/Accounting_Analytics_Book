table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: [Year]

	column YearQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: [YearQuarter]

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: [YearMonth]

	partition Date = calculated
		mode: import
		source =
			ADDCOLUMNS (
			    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2027, 12, 31 ) ),
			    "Year", YEAR ( [Date] ),
			    "YearQuarter", YEAR ( [Date] ) & "-Q" & QUARTER ( [Date] ),
			    "YearMonth", FORMAT ( [Date], "yyyy-mm" )
			)

