table Requisitions

	column RequisitionID
		dataType: int64
		summarizeBy: none
		sourceColumn: RequisitionID

	column RequestDate
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: RequestDate

	column ItemID
		dataType: int64
		summarizeBy: none
		sourceColumn: ItemID

	column Quantity
		dataType: double
		summarizeBy: sum
		sourceColumn: Quantity

	column EstimatedUnitCost
		dataType: double
		summarizeBy: none
		sourceColumn: EstimatedUnitCost

	column Justification
		dataType: string
		summarizeBy: none
		sourceColumn: Justification

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

	column ApproverTitle
		dataType: string
		summarizeBy: none
		sourceColumn: ApproverTitle

	partition Requisitions = m
		mode: import
		source =
			let
			    Source = RequisitionsStaged
			in
			    Source

