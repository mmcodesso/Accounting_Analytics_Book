	column DocumentNumber
		dataType: string
		summarizeBy: none
		sourceColumn: DocumentNumber

	column Disposition
		dataType: string
		summarizeBy: none
		sourceColumn: Disposition

	column Note
		dataType: string
		summarizeBy: none
		sourceColumn: Note

	partition Dispositions = m
