table PurchaseOrder

	column PurchaseOrderID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: PurchaseOrderID

	column PONumber
		dataType: string
		summarizeBy: none
		sourceColumn: PONumber

	column OrderDate
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: OrderDate

	column OrderTotal
		dataType: double
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: OrderTotal

	column CreatedByEmployeeID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CreatedByEmployeeID

	column ApprovedByEmployeeID
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ApprovedByEmployeeID

	column ApproverLimit
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: ApproverLimit

	column ApproverTermination
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: ApproverTermination

	column SelfApproved
		dataType: int64
		summarizeBy: none
		sourceColumn: SelfApproved

	column AboveLimit
		dataType: int64
		summarizeBy: none
		sourceColumn: AboveLimit

	column AfterTermination
		dataType: int64
		summarizeBy: none
		sourceColumn: AfterTermination

	partition PurchaseOrder = m
		mode: import
		source =
			let
			    Source = PurchaseOrderFlags
			in
			    Source

