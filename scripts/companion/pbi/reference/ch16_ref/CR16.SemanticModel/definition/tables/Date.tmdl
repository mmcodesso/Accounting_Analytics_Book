table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: [Date]
		isKey

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: [Year]

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: [Quarter]

	column YearQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: [YearQuarter]

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: [YearMonth]

	column MonthNumber
		dataType: int64
		summarizeBy: none
		sourceColumn: [MonthNumber]

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: [MonthName]
		sortByColumn: MonthNumber

	partition Date = calculated
		mode: import
		source =
			ADDCOLUMNS (
			    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2027, 12, 31 ) ),
			    "Year", YEAR ( [Date] ),
			    "Quarter", "Q" & QUARTER ( [Date] ),
			    "YearQuarter", YEAR ( [Date] ) & "-Q" & QUARTER ( [Date] ),
			    "YearMonth", FORMAT ( [Date], "yyyy-mm" ),
			    "MonthNumber", MONTH ( [Date] ),
			    "MonthName", FORMAT ( [Date], "mmm" )
			)

