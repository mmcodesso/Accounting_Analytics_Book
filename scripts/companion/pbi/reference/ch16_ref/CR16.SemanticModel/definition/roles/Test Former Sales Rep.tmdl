role 'Test Former Sales Rep'
	modelPermission: read

	tablePermission CostCenter = [CostCenterID] IN CALCULATETABLE ( VALUES ( Security[CostCenterID] ), Security[UserPrincipalName] = "employee083@charlesriver.example" )

	tablePermission Employee = [CostCenterID] IN CALCULATETABLE ( VALUES ( Security[CostCenterID] ), Security[UserPrincipalName] = "employee083@charlesriver.example" )

	tablePermission Item = "employee083@charlesriver.example" IN VALUES ( Security[UserPrincipalName] )

	tablePermission Security = [UserPrincipalName] = "employee083@charlesriver.example"
