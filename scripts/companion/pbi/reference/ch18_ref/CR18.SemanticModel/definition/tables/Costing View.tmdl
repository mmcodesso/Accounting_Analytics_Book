table 'Costing View'

	column View
		dataType: string
		isNameInferred
		summarizeBy: none
		sourceColumn: [View]

	column Order
		dataType: int64
		isNameInferred
		summarizeBy: none
		sourceColumn: [Order]

	partition 'Costing View' = calculated
		mode: import
		source =
			DATATABLE ( "View", STRING, "Order", INTEGER, { { "Standard", 1 }, { "Absorption", 2 }, { "Time-driven", 3 } } )

