<mxfile host="Electron" version="29.6.6">
  <diagram name="The Spectrum of Data Structure" id="fig-02-01-spectrum-data-structure">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="306" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="306" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Structured Data&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="c2" value="Data organized into predefined rows and columns, with each column having a defined data type." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Accounting example:&lt;/b&gt; The Charles River GLEntry table with columns for PostingDate, AccountID, Debit, Credit, SourceDocumentType, and FiscalPeriod. Each row is one posted ledger entry." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="118" width="270" height="104" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Semi-Structured Data&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#FFFFFF;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="295" y="0" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="c5" value="Data with some organizational elements (tags, labels, hierarchy) but not in a strict row-and-column format." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="295" y="34" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Accounting example:&lt;/b&gt; An XBRL financial filing with tagged data elements organized hierarchically, or a bank statement in PDF format containing embedded transaction tables." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="295" y="118" width="270" height="104" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Unstructured Data&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F39C12;strokeColor=#F39C12;strokeWidth=1;fontColor=#2C3E50;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="0" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="c8" value="Data with no predefined tabular format. Information is stored as free-form text, images, or documents." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="34" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Accounting example:&lt;/b&gt; The text of a lease agreement, narrative disclosures in an annual report, email correspondence between auditors and clients, or scanned invoice images." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="118" width="270" height="104" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="12" y="244" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c11" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="847" y="244" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="More structure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="252" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="Less structure" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=13;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="660" y="252" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;i&gt;Excel, SQL, and Power BI are designed for structured data. The Charles River dataset is entirely structured.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="282" width="860" height="22" as="geometry"/></mxCell>
      </root>
