        <mxCell id="c25" value="Table: Customer (220 rows)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="696" height="24" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;A&lt;/b&gt;: the row context alone filters nothing, so SUM adds every invoice line on every row (coral outline)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="216" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;B&lt;/b&gt;: CALCULATE turns the current customer into a filter, and the relationship carries it to the lines: each customer&#x27;s own revenue (teal outline)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="860" height="40" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;i&gt;Two calculated columns on the Customer table in Table view, sorted by Revenue Own, largest first, with all years of invoice lines. The two columns are left in the General format, without a thousands separator.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="284" width="860" height="40" as="geometry"/></mxCell>
