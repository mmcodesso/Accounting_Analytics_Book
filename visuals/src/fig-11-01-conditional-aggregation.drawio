        <mxCell id="c37" value="&lt;b&gt;Completions&lt;/b&gt; = SUM(CASE WHEN SourceDocumentType = &#x27;ProductionCompletion&#x27; THEN Credit ELSE 0 END)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="214" width="832" height="22" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;i&gt;Each CASE passes the amount of one source and zero for every other row, so each sum collects one source. The WorkOrderClose rows meet no condition and add zero to every column.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="246" width="860" height="40" as="geometry"/></mxCell>
