        <mxCell id="c10" value="Entries by creator and type; five flags on each entry (weekend creation, created after the posting date, same creator and approver, above the approver&#x27;s limit, round thousands); RiskScore is their sum." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="103" width="660" height="42" as="geometry"/></mxCell>
