        <mxCell id="c8" value="851 entries; their TotalAmount agrees with the debits of the ledger&#x27;s JournalEntry lines." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="78" width="660" height="25" as="geometry"/></mxCell>
