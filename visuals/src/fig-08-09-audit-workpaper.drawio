        <mxCell id="c14" value="33 entries flagged: 25 with one flag, 7 with two, and 1 with four." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="187" width="660" height="25" as="geometry"/></mxCell>
