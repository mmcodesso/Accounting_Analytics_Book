        <mxCell id="c12" value="Weekend: WEEKDAY(CreatedDate,2)&amp;gt;5. Limit: Employee MaxApprovalAmount of the approver. Round: MOD(TotalAmount,1000)=0." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="145" width="660" height="42" as="geometry"/></mxCell>
