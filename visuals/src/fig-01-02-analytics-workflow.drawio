<mxfile host="Electron" version="29.6.6">
  <diagram name="The Accounting Analytics Workflow" id="fig-01-02-analytics-workflow">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="280" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="280" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;1. Define the question&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Translate the business need into a specific analytical question&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;2. Access the data&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Identify sources, extract relevant tables and columns&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;3. Prepare and clean&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Resolve missing values, duplicates, inconsistent formatting&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="0" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;4. Analyze&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Summarize, compare, model, detect anomalies&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;5. Visualize and present&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Charts, dashboards, interactive reports for stakeholders&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="240" height="86" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;6. Communicate findings&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2C3E50&quot;&gt;Memoranda, presentations, and reports to decision makers&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F39C12;strokeColor=#F39C12;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="240" height="86" as="geometry"/></mxCell>
