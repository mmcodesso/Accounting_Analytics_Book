        <mxCell id="c17" value="&lt;b&gt;Measures the effect of volume:&lt;/b&gt; what the plan&#x27;s volume assumption was worth. At Charles River, the planned volume was several times what was sold." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Measures the effect of prices:&lt;/b&gt; actual revenue against the plan&#x27;s prices for the same units. Costs are at standard in both, so no cost effect appears here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;i&gt;The flexible budget keeps the plan&#x27;s prices and costs per unit but uses the actual quantity of each item sold in each month.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="370" width="860" height="40" as="geometry"/></mxCell>
