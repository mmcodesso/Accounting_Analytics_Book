        <mxCell id="c88" value="All 64 hourly manufacturing employees: 2 different clock-in times, one number of hours; 64 worked overtime, 288.0 hours in all." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="436" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c89" value="&lt;i&gt;The same six Assemblers on both days; a clock-out after midnight falls on the next day. Highlighted: the identical times and hours of the surge day, when the two shifts clocked in at the same minutes.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="860" height="40" as="geometry"/></mxCell>
