        <mxCell id="c39" value="&lt;i&gt;... 9 rows in all: 3 departments × 3 months&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#5D6D7E;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="356" width="400" height="24" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;Tidy data principles satisfied:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;1. Each variable (Department, Month, Budget Amount) has its own column.&lt;br&gt;2. Each observation (one department in one month) has its own row.&lt;br&gt;3. This single table holds one type of observational unit (monthly budgets)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="232" width="350" height="136" as="geometry"/></mxCell>
