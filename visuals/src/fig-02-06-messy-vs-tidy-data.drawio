        <mxCell id="c22" value="&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;Reshape to tidy format&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="216" y="152" width="240" height="22" as="geometry"/></mxCell>
