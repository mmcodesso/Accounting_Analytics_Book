        <mxCell id="c111" value="Expected by Benford&#x27;s Law" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="344" width="220" height="24" as="geometry"/></mxCell>
        <mxCell id="c112" value="&lt;i&gt;Supplier payments dated in fiscal 2024 through 2026, split by the Partial column (a payment smaller than its invoice). Every partial payment belongs to an invoice of $1,000 or more, and most of those invoices are between $1,000 and $2,000, so their parts start with digits from 3 to 9 far more often than Benford&#x27;s Law expects.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="376" width="860" height="56" as="geometry"/></mxCell>
