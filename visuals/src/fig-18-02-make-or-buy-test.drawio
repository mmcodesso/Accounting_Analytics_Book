<mxfile host="Electron" version="29.6.6">
  <diagram name="The Make-or-Buy Test for One Family" id="fig-18-02-make-or-buy-test">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="614" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="614" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Delivered quote&lt;/b&gt;&lt;br&gt;price plus inbound freight, per unit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="300" height="52" as="geometry"/></mxCell>
        <mxCell id="c2" value="Is it below &lt;b&gt;materials plus factory overhead&lt;/b&gt;, the cost that stops even if the crew stays?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c3" value="Is it below that cost &lt;b&gt;plus the crew time&lt;/b&gt; the family uses?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c4" value="Will the crew be &lt;b&gt;reduced in step&lt;/b&gt; with the hours freed?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Buy&lt;/b&gt;, if the terms, quality, and minimum volume are acceptable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="92" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Buy, with the crew plan&lt;/b&gt;: weigh tooling and severance over the quote&#x27;s two years" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="320" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Keep making&lt;/b&gt;: buying adds cost while the crew stays; test the price as well" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="434" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Keep making&lt;/b&gt;, and test the price against the margin floor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="434" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Below the floor?&lt;/b&gt; Reprice, and weigh the volume the increase could cost" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="548" width="300" height="64" as="geometry"/></mxCell>
