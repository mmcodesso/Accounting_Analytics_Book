        <mxCell id="c102" value="&lt;b&gt;Partition: 2025&lt;/b&gt;&lt;br&gt;the year-to-date total restarts in January" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="50" width="220" height="60" as="geometry"/></mxCell>
