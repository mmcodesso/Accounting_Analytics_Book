<mxfile host="Electron" version="29.6.6">
  <diagram name="The Anatomy of a SQL Query" id="fig-09-08-query-anatomy">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="356" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="356" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;i&gt;&lt;font color=&quot;#5D6D7E&quot;&gt;-- The ten largest variances of fiscal 2026&lt;/font&gt;&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="c2" value="A comment says what the query answers. It is ignored when the query runs." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="0" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SELECT&lt;/font&gt;&lt;/b&gt;&amp;nbsp;WorkOrderCloseID,&amp;nbsp;CloseDate,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;ROUND&lt;/font&gt;&lt;/b&gt;(OverheadVarianceAmount&amp;nbsp;/&amp;nbsp;TotalVarianceAmount,&amp;nbsp;2)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;AS&lt;/font&gt;&lt;/b&gt;&amp;nbsp;OverheadShare" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="520" height="72" as="geometry"/></mxCell>
        <mxCell id="c4" value="The columns to return, including a calculated column with an alias." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="50" width="320" height="72" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;FROM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;WorkOrderClose" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="128" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="c6" value="The table the rows come from." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="128" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;WHERE&lt;/font&gt;&lt;/b&gt;&amp;nbsp;CloseDate&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;BETWEEN&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;font color=&quot;#117A65&quot;&gt;&#x27;2026-01-01&#x27;&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;AND&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;font color=&quot;#117A65&quot;&gt;&#x27;2026-12-31&#x27;&lt;/font&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="178" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="c8" value="The condition a row must meet to be kept: the closes of fiscal 2026." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="178" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;ORDER&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;BY&lt;/font&gt;&lt;/b&gt;&amp;nbsp;TotalVarianceAmount&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;DESC&lt;/font&gt;&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="228" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="c10" value="The sort: the largest variance first." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="228" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;LIMIT&lt;/font&gt;&lt;/b&gt;&amp;nbsp;10;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="278" width="520" height="44" as="geometry"/></mxCell>
        <mxCell id="c12" value="How many rows to keep, and the semicolon that ends the statement." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="278" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;i&gt;The clauses must be written in this order. Only SELECT is always required; the others appear when a query uses them.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="332" width="860" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
