        <mxCell id="c41" value="&lt;b&gt;Column formula, copied by hand:&lt;/b&gt;&lt;br&gt;P10646 holds =ROUND(G10646*H10646,2). The formula was typed in P2 and copied down, so every row has its own copy. Rows added below the data get no formula until you copy it again." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="202" width="424" height="84" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;Total:&lt;/b&gt; =SUM(K2:K27934)&lt;br&gt;The formula names fixed cells. Rows added below row 27934 are left out of the total, and nothing warns you." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="436" y="202" width="424" height="84" as="geometry"/></mxCell>
