        <mxCell id="c82" value="&lt;b&gt;Calculated column:&lt;/b&gt;&lt;br&gt;=ROUND([@Quantity]*[@BaseListPrice],2)&lt;br&gt;One formula for the whole column. Excel fills it into every row, including rows added later." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="424" height="84" as="geometry"/></mxCell>
        <mxCell id="c83" value="&lt;b&gt;Total:&lt;/b&gt; =SUM(SalesInvoiceLine[LineTotal])&lt;br&gt;Includes every row the Table holds, however many there are." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="436" y="520" width="424" height="84" as="geometry"/></mxCell>
        <mxCell id="c84" value="&lt;i&gt;Both views show the same cells. Shaded row: line 10645, the Alder Desk sold on invoice SI-2025-007947, which you traced in Tutorial 3.2. The selected cell holds the plain range&#x27;s formula for that line.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="614" width="860" height="40" as="geometry"/></mxCell>
