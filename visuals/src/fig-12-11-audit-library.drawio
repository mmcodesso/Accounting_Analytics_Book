        <mxCell id="c15" value="&lt;i&gt;&lt;font color=&quot;#5D6D7E&quot;&gt;-- Tutorial 12.1, test L1: journal entries against the ledger&lt;/font&gt;&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="38" y="128" width="818" height="20" as="geometry"/></mxCell>
