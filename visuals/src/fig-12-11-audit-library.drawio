        <mxCell id="c21" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SELECT&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;COUNT&lt;/font&gt;&lt;/b&gt;(*)&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;FROM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;JournalEntry)&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;AS&lt;/font&gt;&lt;/b&gt;&amp;nbsp;Entries," style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="38" y="188" width="818" height="20" as="geometry"/></mxCell>
