        <!-- Tidy principles annotation -->
        <mxCell id="tidy_principle_box" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;font color=&quot;#17A589&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Tidy data principles satisfied:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2C3E50&quot; style=&quot;font-size:10px;&quot;&gt;1. Each variable (Department, Month, Budget Amount) has its own column.&lt;br&gt;2. Each observation (one department in one month) has its own row.&lt;br&gt;3. This single table holds one type of observational unit (monthly budgets).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#17A589;strokeWidth=1;arcSize=8;verticalAlign=middle;spacing=10;fontFamily=Helvetica;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="370" width="330" height="95" as="geometry"/>
        </mxCell>

        <!-- Why it matters annotation for messy side -->
        <mxCell id="messy_principle_box" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;font color=&quot;#E74C3C&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Tidy data principles violated:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2C3E50&quot; style=&quot;font-size:10px;&quot;&gt;1. Month is stored in column headers, not in its own column.&lt;br&gt;2. Each row contains three observations (three months), not one.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;strokeWidth=1;arcSize=8;verticalAlign=middle;spacing=10;fontFamily=Helvetica;align=left;" vertex="1" parent="1">
