        <mxCell id="messy_anno" value="&lt;font color=&quot;#E74C3C&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Problem:&lt;/b&gt; &lt;/font&gt;&lt;font color=&quot;#2C3E50&quot; style=&quot;font-size:10px;&quot;&gt;Month names are stored as column headers, not as data values. Budget Amount is spread across three columns instead of one. This layout prevents direct use in PivotTables, SQL GROUP BY queries, or Power BI data models.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="196" width="420" height="55" as="geometry"/>
