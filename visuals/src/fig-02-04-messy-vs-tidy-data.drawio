        <mxCell id="t_ellipsis" value="&lt;font style=&quot;font-size:10px;&quot; color=&quot;#5D6D7E&quot;&gt;&lt;i&gt;... (9 rows total: 3 departments &#x00D7; 3 months)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;fontFamily=Helvetica;" vertex="1" parent="1">
