        <mxCell id="c25" value="&lt;b&gt;Adjusted&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="728" y="196" width="128" height="50" as="geometry"/></mxCell>
        <mxCell id="c26" value="Each missed item reverses in the next year. An error that recurs every year can leave income nearly right while the balance sheet stays wrong." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="258" width="860" height="40" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="420" height="136" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;Correction of an error&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="14" y="326" width="392" height="22" as="geometry"/></mxCell>
        <mxCell id="c29" value="The facts existed at the year-end and were missed or misapplied. The correction goes to the period in which they existed: the prior year&#x27;s figures are restated, and an earlier error enters opening retained earnings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="14" y="352" width="392" height="92" as="geometry"/></mxCell>
        <mxCell id="c30" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="316" width="420" height="136" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;Change in estimate&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="454" y="326" width="392" height="22" as="geometry"/></mxCell>
        <mxCell id="c32" value="The year-end estimate was reasonable on the facts then available. A later difference goes to the period in which it becomes known, and to later periods if they are affected. Nothing is restated." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="454" y="352" width="392" height="92" as="geometry"/></mxCell>
