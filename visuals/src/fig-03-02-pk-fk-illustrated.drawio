        <mxCell id="c32" value="&lt;i&gt;One customer places zero or many sales orders&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="470" y="22" width="330" height="20" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;Primary key (PK).&lt;/b&gt; CustomerID uniquely identifies each customer in the Customer table.&lt;br&gt;&lt;b&gt;Foreign key (FK).&lt;/b&gt; SalesOrder.CustomerID stores the CustomerID of the customer who placed each order. Orders 62 and 85 both point to customer 1, Walters PLC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="960" height="50" as="geometry"/></mxCell>
