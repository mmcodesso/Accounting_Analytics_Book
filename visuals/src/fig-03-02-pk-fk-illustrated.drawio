        <mxCell id="c25" value="&lt;i&gt;One customer places zero or many sales orders&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="0" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Primary key (PK).&lt;/b&gt; CustomerID uniquely identifies each customer in the Customer table.&lt;br&gt;&lt;b&gt;Foreign key (FK).&lt;/b&gt; SalesOrder.CustomerID stores the CustomerID of the customer who placed each order. Orders 62 and 85 both point to Walters PLC, customer 1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="176" width="860" height="60" as="geometry"/></mxCell>
