        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5D6D7E;strokeWidth=1.5;endArrow=classic;" edge="1" source="cust" target="so" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
