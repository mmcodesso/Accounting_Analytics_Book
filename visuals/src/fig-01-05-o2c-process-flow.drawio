        <mxCell id="cra" value="&lt;b&gt;CashReceipt&lt;br&gt;Application&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;links receipt&lt;br&gt;to invoice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1;fontSize=10;fontFamily=Arial;verticalAlign=middle;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
