        <mxCell id="title" value="&lt;b&gt;Figure 1.5: Simplified Order-to-Cash Process Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#1A5276;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
