        <mxCell id="cr" value="&lt;b&gt;CashReceipt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;receipt date,&lt;br&gt;amount, method&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="130" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="gle" value="&lt;b&gt;GLEntry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#FFFFFF'&gt;Accounting Core&lt;br&gt;debit/credit posting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A5276;fontColor=#FFFFFF;strokeColor=#1A5276;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="140" height="70" as="geometry"/>
