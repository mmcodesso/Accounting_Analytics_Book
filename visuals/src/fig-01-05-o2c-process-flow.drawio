<mxfile>
  <diagram name="O2C Process Flow" id="fig0105v2">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="cust" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;places order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="so" value="&lt;b&gt;SalesOrder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;header: customer,&lt;br&gt;date, status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="sol" value="&lt;b&gt;SalesOrderLine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;item, qty, price,&lt;br&gt;discount&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="130" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ship" value="&lt;b&gt;Shipment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;ship date, carrier,&lt;br&gt;tracking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="200" width="130" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="si" value="&lt;b&gt;SalesInvoice&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;invoice date,&lt;br&gt;total amount, terms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
