        <mxCell id="item" value="&lt;b&gt;Item&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#5D6D7E'&gt;Master Data:&lt;br&gt;product info, cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F39C12;strokeWidth=1.5;fontSize=11;fontFamily=Arial;verticalAlign=middle;" vertex="1" parent="1">
