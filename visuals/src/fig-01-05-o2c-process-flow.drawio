        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5D6D7E;strokeWidth=1;endArrow=classic;" edge="1" source="cr" target="cra" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
