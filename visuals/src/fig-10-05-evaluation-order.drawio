        <mxCell id="c37" value="keep the first rows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="562" y="290" width="298" height="34" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;i&gt;The number beside each written clause is the step at which it is evaluated. WHERE runs before any group exists, so it cannot use an aggregate; HAVING runs after grouping, and ORDER BY after SELECT.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="338" width="860" height="40" as="geometry"/></mxCell>
