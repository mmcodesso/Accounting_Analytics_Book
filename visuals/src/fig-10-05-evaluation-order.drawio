        <mxCell id="c34" value="sort the result; the aliases of SELECT can be used" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="562" y="246" width="298" height="34" as="geometry"/></mxCell>
