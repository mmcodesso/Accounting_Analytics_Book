        <mxCell id="c44" value="&lt;i&gt;A comparison with NULL is never true, so = NULL keeps no row, closed or open. IS NULL is true for the work orders with no ClosedDate, and COALESCE shows a stand-in value where the date is missing.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="204" width="860" height="40" as="geometry"/></mxCell>
