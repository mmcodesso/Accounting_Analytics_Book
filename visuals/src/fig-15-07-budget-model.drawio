        <mxCell id="c117" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="487" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c118" value="BudgetDate, the first day of each budget month, added in Tutorial 15.2 &amp;nbsp;&amp;nbsp;&lt;b&gt;1&lt;/b&gt;&amp;nbsp;the table that holds the key &amp;nbsp;&amp;nbsp;&lt;b&gt;*&lt;/b&gt;&amp;nbsp;the table that refers to it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="484" width="838" height="22" as="geometry"/></mxCell>
        <mxCell id="c119" value="&lt;i&gt;Part of the model: the other tables are not shown. Account, CostCenter, and Date each filter both fact tables, so a visual grouped by cost center or month can place the budget beside the ledger. Budget lines without a cost center, and ledger postings without one, meet in the (Blank) row.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="510" width="860" height="56" as="geometry"/></mxCell>
