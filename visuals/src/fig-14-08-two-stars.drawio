        <mxCell id="c138" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;the table that holds the key &amp;nbsp;&amp;nbsp;&lt;b&gt;*&lt;/b&gt;&amp;nbsp;the table that refers to it &amp;nbsp;&amp;nbsp;&lt;b&gt;Arrow&lt;/b&gt;&amp;nbsp;the direction of the filter, from each dimension to the fact table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="498" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c139" value="&lt;i&gt;The model after Tutorial 14.3: the sales star on the left, the ledger star on the right, and the Date table related to both. The Measures table, which has no relationships, is not shown.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="524" width="860" height="40" as="geometry"/></mxCell>
