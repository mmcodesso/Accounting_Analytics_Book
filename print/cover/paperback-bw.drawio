        <mxCell id="publisher" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=19;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" value="Accounting Analytics Hub" vertex="1"><mxGeometry x="1046.30" y="956.00" width="460.00" height="36.00" as="geometry"/></mxCell>
        <mxCell id="spine-title" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=40;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;rotation=90;" value="&lt;div style=&quot;line-height:46px&quot;&gt;ACCOUNTING ANALYTICS&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:22px;margin-top:8px;color:#E3A93B&quot;&gt;AN INTEGRATED APPROACH&lt;/div&gt;" vertex="1"><mxGeometry x="587.30" y="339.60" width="633.60" height="84.00" as="geometry"/></mxCell>
        <mxCell id="spine-author" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=right;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;rotation=90;" value="&lt;div style=&quot;line-height:28px&quot;&gt;Mauricio Codesso, Ph.D.&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;margin-top:8px&quot;&gt;Accounting Analytics Hub&lt;/div&gt;" vertex="1"><mxGeometry x="755.30" y="824.40" width="297.60" height="84.00" as="geometry"/></mxCell>
        <mxCell id="back-copy" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" value="&lt;div style=&quot;font-size:30px;line-height:36px;font-weight:bold;margin-bottom:14px&quot;&gt;Learn analytics through&lt;br&gt;accounting questions.&lt;/div&gt;&lt;div style=&quot;width:76px;border-top:3px solid #E3A93B;margin-bottom:22px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:23px&quot;&gt;&lt;p style=&quot;margin:0 0 14px 0&quot;&gt;Accounting now runs on data. Every transaction, journal entry, payment, and production order sits in a database, and auditors, management accountants, and financial reporting teams are expected to work with that data directly.&lt;/p&gt;&lt;p style=&quot;margin:0 0 14px 0&quot;&gt;&lt;i&gt;Accounting Analytics: An Integrated Approach&lt;/i&gt; teaches you to extract, prepare, analyze, and visualize it with Microsoft Excel, SQL, and Microsoft Power BI, three tools widely used in professional practice. Every technique is taught through an accounting question, and every example draws on the records of one company, so a customer order you analyze in Excel is the same one you find in the general ledger with SQL and report on in Power BI.&lt;/p&gt;&lt;ul style=&quot;margin:6px 0 14px 0;padding-left:22px;line-height:22px&quot;&gt;&lt;li style=&quot;color:#E3A93B;margin-bottom:6px&quot;&gt;&lt;span style=&quot;color:#FFFFFF&quot;&gt;Guided tutorials in Excel, SQL, and Power BI, with step-by-step instructions&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;color:#E3A93B;margin-bottom:6px&quot;&gt;&lt;span style=&quot;color:#FFFFFF&quot;&gt;Exercises from three perspectives: financial accounting, managerial accounting, and auditing&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;color:#E3A93B;margin-bottom:6px&quot;&gt;&lt;span style=&quot;color:#FFFFFF&quot;&gt;Capstone cases in financial reporting, managerial accounting, and auditing that bring all three tools together&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;color:#E3A93B;margin-bottom:6px&quot;&gt;&lt;span style=&quot;color:#FFFFFF&quot;&gt;One integrated dataset: Charles River, a fictional company whose transactions trace from source documents to the general ledger&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin:0&quot;&gt;Written for undergraduate and graduate accounting and business students. No prior analytics or programming experience is needed, only introductory financial and managerial accounting.&lt;/p&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="77.99" y="96.00" width="640.00" height="720.00" as="geometry"/></mxCell>
        <mxCell id="back-bio" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" value="&lt;div style=&quot;line-height:19px&quot;&gt;&lt;b&gt;Mauricio Codesso&lt;/b&gt; is an Associate Teaching Professor of Accounting at Northeastern University&#x27;s &lt;span style=&quot;white-space:nowrap&quot;&gt;D&#x27;Amore-McKim&lt;/span&gt; School of Business in Boston. His teaching and research focus on accounting analytics, accounting information systems, managerial accounting, and auditing.&lt;/div&gt;" vertex="1"><mxGeometry x="77.99" y="812.00" width="640.00" height="70.00" as="geometry"/></mxCell>
        <mxCell id="back-footer" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=bottom;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" value="&lt;div style=&quot;line-height:19px&quot;&gt;Open educational resource, licensed CC BY-SA 4.0&lt;/div&gt;&lt;div style=&quot;line-height:19px&quot;&gt;Read it online, with the dataset, slides, companion files, and solutions, at&lt;/div&gt;&lt;div style=&quot;line-height:22px;font-weight:bold;color:#E3A93B;font-size:15px&quot;&gt;aa.accountinganalyticshub.com&lt;/div&gt;" vertex="1"><mxGeometry x="77.99" y="967.87" width="520.00" height="70.00" as="geometry"/></mxCell>
