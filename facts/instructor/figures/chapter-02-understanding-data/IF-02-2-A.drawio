        <mxCell id="c64" value="&lt;i&gt;Outlined: the first period of the first year and the last two periods of the data. Each holds far fewer rows than the 22,601 that a period typically holds.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="352" width="860" height="36" as="geometry"/></mxCell>
