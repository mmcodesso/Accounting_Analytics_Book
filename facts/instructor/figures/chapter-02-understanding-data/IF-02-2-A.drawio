        <mxCell id="c62" value="The outlined periods sit at the edges of the extract. The records begin in the first period, and fiscal 2027 holds only DisbursementPayment rows, which settle the year before: they are not missing sales or purchases." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="384" y="70" width="226" height="104" as="geometry"/></mxCell>
