        <mxCell id="c83" value="Reshaping (Power Query, a PivotTable) changes the layout and leaves every value as it is. Correcting a value changes the data and leaves the layout as it is. A dataset can need either, both or neither: these are different jobs." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="550" width="860" height="44" as="geometry"/></mxCell>
