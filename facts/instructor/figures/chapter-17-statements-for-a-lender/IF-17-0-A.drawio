        <mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.127907;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.872093;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c52" value="&lt;i&gt;Each card is a requirement of the case, in the order of its four phases; the tags name the tools it uses. The teal boxes are the four milestones an instructor may collect and check. Arrows show how results move: Copy with Headers or Export to CSV from the script into the workbook, the workbook&#x27;s Table of adjustment lines into the Review file, and all three files into the memo.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="709" width="860" height="53" as="geometry"/></mxCell>
