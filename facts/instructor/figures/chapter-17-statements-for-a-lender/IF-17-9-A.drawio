        <mxCell id="c83" value="&lt;b&gt;Exhibit 3&lt;/b&gt;&lt;br&gt;The going-concern conditions" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="596" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="c84" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="250" height="5" as="geometry"/></mxCell>
        <mxCell id="c85" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="671" width="175" height="5" as="geometry"/></mxCell>
        <mxCell id="c86" value="&lt;i&gt;Boxes stand for the parts of the memo in the order the requirement gives them; the gray bars stand for text. The two pages and the three exhibits are the limits the requirement sets, and the table of the four required matters is the one the guide&#x27;s model memo uses.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="704" width="860" height="38" as="geometry"/></mxCell>
      </root>
