        <mxCell id="c7" value="&lt;b&gt;Opening&lt;/b&gt;, readable alone&lt;br&gt;What the package required and what it changed&lt;br&gt;The effect on income, on the comparative year and on cash&lt;br&gt;&lt;b&gt;The recommendation&lt;/b&gt;: record some, hold one, do not release yet" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="14" y="92" width="382" height="92" as="geometry"/></mxCell>
