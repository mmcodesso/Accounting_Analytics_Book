        <mxCell id="c58" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="190" y="408" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="c59" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="197" y="421" width="86" height="5" as="geometry"/></mxCell>
        <mxCell id="c60" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="197" y="432" width="86" height="5" as="geometry"/></mxCell>
        <mxCell id="c61" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="197" y="443" width="47.3" height="5" as="geometry"/></mxCell>
        <mxCell id="c62" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="408" width="106" height="50" as="geometry"/></mxCell>
        <mxCell id="c63" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="297" y="421" width="92" height="5" as="geometry"/></mxCell>
        <mxCell id="c64" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="297" y="432" width="92" height="5" as="geometry"/></mxCell>
        <mxCell id="c65" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="297" y="443" width="50.6" height="5" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;The other matters&lt;/b&gt; the records point to, briefly&lt;br&gt;Cash: confirm the balance with the bank&lt;br&gt;Inventories: a count, a net realizable value review and a cost study&lt;br&gt;Later events and going concern, from Requirement 8" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="40" width="382" height="96" as="geometry"/></mxCell>
        <mxCell id="c67" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="40" width="5" height="96" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;The passed items&lt;/b&gt; for the CFO&#x27;s approval&lt;br&gt;Their total and its share of materiality" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="148" width="382" height="56" as="geometry"/></mxCell>
        <mxCell id="c69" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="148" width="5" height="56" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;The changes to the year-end close&lt;/b&gt;&lt;br&gt;Accrue payroll for the days worked&lt;br&gt;Review the open accruals every month&lt;br&gt;Cut revenue off by the delivery date&lt;br&gt;Accrue the interest every month" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="216" width="382" height="96" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;b&gt;The closing recommendation&lt;/b&gt;&lt;br&gt;Record the adjustments the records settle and the reclassifications; record the old accruals once the suppliers&#x27; evidence supports it; do not release the package until the four required matters are settled" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="324" width="382" height="96" as="geometry"/></mxCell>
        <mxCell id="c72" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="464" y="324" width="5" height="96" as="geometry"/></mxCell>
        <mxCell id="c73" value="&lt;b&gt;The appendix of exhibits&lt;/b&gt;: at most three pages, one page for each exhibit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="568" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="c74" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="596" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;b&gt;Exhibit 1&lt;/b&gt;&lt;br&gt;The schedule of adjustments with the passed items" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="596" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="c76" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="10" y="660" width="250" height="5" as="geometry"/></mxCell>
