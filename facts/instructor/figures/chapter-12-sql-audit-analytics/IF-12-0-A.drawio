        <mxCell id="c18" value="plant it in the population" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="82" y="90" width="160" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="the test must return it" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="90" width="150" height="20" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;i&gt;Read left to right. The gray boxes name where the chapter practices each stage. A test that returns no rows is evidence only if the planted exception would have come back from the same test; the loop is the check on the test itself.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="351" width="860" height="42" as="geometry"/></mxCell>
