        <mxCell id="c1" value="&lt;b&gt;Positive control: a planted known exception&lt;/b&gt;&lt;br&gt;Plant one that the test must return. Tutorial&amp;nbsp;12.1, Steps&amp;nbsp;4&amp;nbsp;and&amp;nbsp;6: a test that cannot fail. Exercise&amp;nbsp;12.6, Step&amp;nbsp;5: a planted gap." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="504" height="65" as="geometry"/></mxCell>
