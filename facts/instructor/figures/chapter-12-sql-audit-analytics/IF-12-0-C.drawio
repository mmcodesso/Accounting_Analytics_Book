        <mxCell id="c152" value="Surge days in the month (the count is above each bar)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="330" height="20" as="geometry"/></mxCell>
