        <mxCell id="c141" value="&lt;b&gt;2024: 12 surge days&lt;/b&gt;&lt;br&gt;3,456 overtime hours, 35.5% of the year&#x27;s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="258" height="44" as="geometry"/></mxCell>
