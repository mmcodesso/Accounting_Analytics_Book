  <diagram name="Choosing the SQL Feature" id="IF-11-0-A">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="341" background="#FFFFFF" math="0" shadow="0">
