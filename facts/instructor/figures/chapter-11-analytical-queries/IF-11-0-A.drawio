        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="341" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;CASE&lt;/b&gt;&lt;br&gt;Check: every row falls in one category and the categories tie to the ledger.&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;11.1, Step&amp;nbsp;1&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="5" y="172" width="162" height="124" as="geometry"/></mxCell>
        <mxCell id="c2" value="Which group does each row belong in?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="5" y="78" width="162" height="60" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="&lt;b&gt;SUM with CASE&lt;/b&gt;&lt;br&gt;Check: one row for each month, one column for each source.&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;11.1, Step&amp;nbsp;2&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="177" y="172" width="162" height="124" as="geometry"/></mxCell>
        <mxCell id="c5" value="How much of a measure for each category, side by side?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="177" y="78" width="162" height="60" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Date functions&lt;/b&gt;&lt;br&gt;Check: the last work date against the month end.&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;11.1, Step&amp;nbsp;3&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="349" y="172" width="162" height="124" as="geometry"/></mxCell>
        <mxCell id="c8" value="Which period is a row in, and where do the dates stop?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="349" y="78" width="162" height="60" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="&lt;b&gt;Window: partition, order, frame&lt;/b&gt;&lt;br&gt;Check: the first row has no earlier row; ties share a rank.&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;11.2, Steps&amp;nbsp;1&amp;nbsp;and&amp;nbsp;2&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="521" y="172" width="162" height="124" as="geometry"/></mxCell>
        <mxCell id="c11" value="How does a row compare with the rows around it?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="521" y="78" width="162" height="60" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="&lt;b&gt;CTE chain or view&lt;/b&gt;&lt;br&gt;Check: each step returns every month before the next builds on it.&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;11.3, Steps&amp;nbsp;1&amp;nbsp;to&amp;nbsp;4&amp;nbsp;and&amp;nbsp;6&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="693" y="172" width="162" height="124" as="geometry"/></mxCell>
