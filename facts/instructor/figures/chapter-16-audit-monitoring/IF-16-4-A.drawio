        <mxCell id="c193" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="314" y="579" width="116" height="22" as="geometry"/></mxCell>
        <mxCell id="c194" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="579" width="178" height="22" as="geometry"/></mxCell>
        <mxCell id="c195" value="&lt;b&gt;The total row shows no rate.&lt;/b&gt; Population is blank across processes, so a rate that would mix them is never shown. Dividing all 51 exceptions of 2026 by all 11,441 documents would read 4.5, a figure no process has." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="628" y="465" width="216" height="104" as="geometry"/></mxCell>
