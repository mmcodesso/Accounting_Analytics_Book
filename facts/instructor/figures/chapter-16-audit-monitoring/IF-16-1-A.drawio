        <mxCell id="c60" value="&lt;b&gt;225&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=15;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="547.667" y="124" width="137.667" height="24" as="geometry"/></mxCell>
        <mxCell id="c61" value="Credit Balance&lt;br&gt;Invoices" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="547.667" y="152" width="137.667" height="34" as="geometry"/></mxCell>
        <mxCell id="c62" value="&lt;b&gt;The difference is one line.&lt;/b&gt; Unreconciled Difference, 380,000.00, is the JournalEntry row of the table on the left: a line of JE-2024-000001 that no invoice supports. The other sources net to the open balance." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="392" y="212" width="452" height="59" as="geometry"/></mxCell>
        <mxCell id="c63" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="392" y="212" width="5" height="59" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;b&gt;The credit balances stand apart.&lt;/b&gt; 225 invoices have applications and credit memos above their total, and their -220,131.88, recorded as customer credits, is outside the open balance. Netted in, they would add a second difference, 600,131.88, which is no new finding." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="392" y="283" width="452" height="74" as="geometry"/></mxCell>
        <mxCell id="c65" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#5D6D7E;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="392" y="283" width="5" height="74" as="geometry"/></mxCell>
        <mxCell id="c66" value="Review" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="4" y="400" width="61.336" height="24" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;Ex 16.1&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=2;fontColor=#1A5276;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="67.336" y="400" width="63.364" height="24" as="geometry"/></mxCell>
        <mxCell id="c68" value="Ex 16.2" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="132.7" y="400" width="62.692" height="24" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="197.392" y="400" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;i&gt;Report view, page Ex 16.1, with the as-of date 2026-12-31 typed in every query. Outlined: the JournalEntry row of the ledger table. The buckets follow BucketOrder, and both tables show Desktop&#x27;s total row. The page&#x27;s text box with the written answers is not drawn.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="860" height="38" as="geometry"/></mxCell>
