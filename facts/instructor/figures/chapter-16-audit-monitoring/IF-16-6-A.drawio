        <mxCell id="c13" value="&lt;b&gt;None of the 113 pairs pays one invoice.&lt;/b&gt; The card reads 0 and not blank, because the measure adds 0. Two payments of one supplier and one amount on different invoices are an anomaly to look at, not a duplicate payment." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="368" y="16" width="476" height="59" as="geometry"/></mxCell>
