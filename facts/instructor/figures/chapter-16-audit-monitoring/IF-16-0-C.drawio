        <mxCell id="c7" value="&lt;b&gt;Tutorial&amp;nbsp;16.3&lt;/b&gt; Test 3&#x27;s key counts, the dispositions by kind, the open exceptions by process and year, the documents that fail two tests or more, Test 4&#x27;s orders and registers, and Data Through with each year selected" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="212" width="352" height="78" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;34&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="212" width="66" height="78" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Exercise&amp;nbsp;16.1&lt;/b&gt; The open invoices, balance and customers, the five buckets, the largest balance over 90 days, account 1020, the difference and its source, and the credit balances" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="298" width="352" height="63" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;15&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="298" width="66" height="63" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Exercise&amp;nbsp;16.2&lt;/b&gt; Both cutoff tests by year, their subtotal and standard cost, the rows of the copied register and of Tests 16.2, and the extra invoice&#x27;s posting and year" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="369" width="352" height="63" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;13&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="369" width="66" height="63" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Exercise&amp;nbsp;16.3&lt;/b&gt; The surge days in all and by year, the first day, the employees and hours of the surge entries, and each year&#x27;s surge overtime, share and overtime on other days" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="352" height="63" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;21&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="440" width="66" height="63" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;Exercise&amp;nbsp;16.4&lt;/b&gt; Exceptions, population and both rates for each process and year; the unexplained rate with a test selected and the total row&#x27;s rate, both blank" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="511" width="352" height="63" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;38&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="511" width="66" height="63" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;Exercise&amp;nbsp;16.5&lt;/b&gt; The payments, full and partial, the deviation of each group and of all payments, and the payments whose first digit is 0 or whose text begins with 0" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="582" width="352" height="63" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;13&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="582" width="66" height="63" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;Exercise&amp;nbsp;16.6&lt;/b&gt; The pairs, those within 30 days and on the same invoice, and the orders, entries and registers approved by the Chief Financial Officer, the Controller and the Accounting Manager, with their shares" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="653" width="352" height="78" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;16&lt;/b&gt;&lt;br&gt;rows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="356" y="653" width="66" height="78" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;The heat map&#x27;s shading&lt;/b&gt; The Checks tab tests the count in each cell of the Monitoring matrix, but not the rule colors that make January darkest, or that the number stays in every cell&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;16.2, Step&amp;nbsp;11&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="40" width="422" height="78" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;The drill-through click&lt;/b&gt; The right-click that opens Entry Lines or Exception Detail, and the filters the click passes: the page&#x27;s rows come from the cell, not from a measure&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;16.1, Step&amp;nbsp;10; Tutorial&amp;nbsp;16.2, Step&amp;nbsp;13&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="126" width="422" height="78" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;The edited interactions as a reader meets them&lt;/b&gt; On Monitoring the project disables approvers to rates, approvers to Data Through and heat map to Data Through, and keeps heat map to rates available for the selected context. On Exercise&amp;nbsp;16.5 it disables the PaymentKind slicer to the deviation table. Verify each source and target pair in Desktop&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;16.2, Step&amp;nbsp;12c; Tutorial&amp;nbsp;16.3, Step&amp;nbsp;7c; Exercise&amp;nbsp;16.5, Step&amp;nbsp;4d&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="212" width="422" height="108" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;The Data Through card under a slicer&lt;/b&gt; The Checks tab tests the date with each year selected (2024-12-20, 2025-12-19, 2026-12-18), but not that the card on the page follows the Year slicer and ignores a click&lt;br&gt;&lt;i&gt;Tutorial&amp;nbsp;16.3, Step&amp;nbsp;7&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="328" width="422" height="78" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;The Power Query step names a student chose&lt;/b&gt; The project&#x27;s steps carry Desktop&#x27;s names. A student&#x27;s queries are read in the file, because the Checks tab tests the model and not how it was built&lt;br&gt;&lt;i&gt;Tutorials 16.1 to 16.3; every exercise&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="414" width="422" height="78" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;i&gt;The Checks tab of the model answer holds 299 rows, a section for each tutorial and exercise. Choose Home &gt; Refresh, then Run. A row tests a value, not how a visual looks, so the right-hand column is for the instructor to open the pages.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="743" width="860" height="38" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
