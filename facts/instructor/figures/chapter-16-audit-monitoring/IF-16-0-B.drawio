        <mxCell id="c154" value="&lt;b&gt;*&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="683.284" y="482" width="14" height="19" as="geometry"/></mxCell>
        <mxCell id="c155" value="&lt;b&gt;1&lt;/b&gt; the table that holds the key &amp;nbsp; &lt;b&gt;*&lt;/b&gt; the table that refers to it &amp;nbsp; Arrow: the way a filter flows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="594" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c156" value="&lt;i&gt;The nine tables of the tutorials, each with some of its columns. Employee reaches the entries through their approver, and no other population: PurchaseOrder and PayrollRegister have no line to it. The model answer holds 21 tables and 13 relationships, all active and single direction. The exercises add 5 relationships, for ClockEntries, Exceptions 16.2, Payments, SurgeDays and Tests 16.2, and 6 tables with none (ARCreditBalances, ARInvoices, ARLedger, CutoffInvoiceLines, Digits, PaymentPairs). Key Measures, which holds the measures, is not drawn.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="620" width="860" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
