        <mxCell id="c1" value="&lt;b&gt;Tutorial&amp;nbsp;16.1&lt;br&gt;Journal Entry Monitoring&lt;/b&gt;&lt;br&gt;JournalEntry with the approver&#x27;s limit, five flags and the risk score; JournalLines, the entries&#x27; ledger lines; JE Exceptions, 43 rows, not loaded&lt;br&gt;Pages Journal Entries, Entry Lines (drill-through) and Validation; Test 1 reconciles 851 entries&lt;br&gt;&lt;i&gt;12 steps&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="270" height="166" as="geometry"/></mxCell>
