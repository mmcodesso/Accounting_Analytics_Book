        <mxCell id="c16" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="109.25" y="142" width="1.5" height="34" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;Invoice date&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-04&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="160" height="40" as="geometry"/></mxCell>
