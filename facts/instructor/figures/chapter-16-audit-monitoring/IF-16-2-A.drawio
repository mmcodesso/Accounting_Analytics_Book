        <mxCell id="c20" value="&lt;b&gt;Shipment date&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-06&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="75.7143" y="210" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="ellipse;html=1;fillColor=#5D6D7E;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="148.714" y="170" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c22" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="246.393" y="142" width="1.5" height="34" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;Delivery date&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-10&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="202" y="102" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="ellipse;html=1;fillColor=#117A65;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240.143" y="170" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="749.25" y="142" width="1.5" height="34" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Ledger posting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2026-01-01&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="670" y="102" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="ellipse;html=1;fillColor=#8A5D00;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="743" y="170" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;A test by invoice date finds nothing here.&lt;/b&gt; It compares the year of the delivery with the year of the invoice. SI-2026-013742 is dated &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-04&lt;/span&gt; and delivered &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-10&lt;/span&gt;: both fall in 2025, so no year differs." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="288" width="418" height="70" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;A test by posting date would find it.&lt;/b&gt; It is posted &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-01-01&lt;/span&gt;, in 2026, a year after the delivery. Chapter 12 counts it among the 8 invoices of January 2026; the exercise&#x27;s test, by invoice date, counts 7." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="442" y="288" width="418" height="70" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;i&gt;The four dates of SI-2026-013742, to scale from December 2025 to the first days of January 2026. The year-end falls between the delivery and the posting. It is Chapter 6&#x27;s revenue cutoff error: revenue recorded in the year after the goods shipped. Each date is read from the dataset.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="368" width="860" height="38" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
