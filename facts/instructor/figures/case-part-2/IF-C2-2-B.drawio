        <mxCell id="c39" value="&lt;b&gt;10.3% of the list amount&lt;/b&gt; goes to the price lists and overrides, and &lt;b&gt;1.1%&lt;/b&gt; goes to promotions. The line rounding, 0.69 dollars in all, is the cent each LineTotal is rounded to." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="232.1" y="224.857" width="437.8" height="66" as="geometry"/></mxCell>
