        <mxCell id="c169" value="&lt;b&gt;$362,110.75&lt;/b&gt;&lt;br&gt;1.22% of billed revenue" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="373" y="488.913" width="180" height="34" as="geometry"/></mxCell>
        <mxCell id="c170" value="&lt;b&gt;Grand total:&lt;/b&gt; $723,253.10 of discount on 2,108 lines, so every promotion line is in a row and no (blank) row remains. The yearly totals in the chart are the PivotTable&#x27;s column totals, rounded year by year, so they add to $723,253.11, a cent from the unrounded grand total." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#EAF2F8;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="455" width="270" height="104" as="geometry"/></mxCell>
