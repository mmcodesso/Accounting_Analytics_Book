        <mxCell id="c172" value="&lt;b&gt;Outlined:&lt;/b&gt; the second column of discount of promotions 2, 3, 5, and 6. Their orders were invoiced in the year after they ran." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#FDEDEC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="581" width="270" height="59" as="geometry"/></mxCell>
        <mxCell id="c173" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#B03A2E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="581" width="5" height="59" as="geometry"/></mxCell>
        <mxCell id="c174" value="&lt;i&gt;The PromotionID filter has (blank), the lines with no promotion, cleared, so they are not counted.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="709" width="860" height="23" as="geometry"/></mxCell>
