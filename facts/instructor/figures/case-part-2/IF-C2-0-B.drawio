        <mxCell id="c60" value="&lt;b&gt;$228,114&lt;/b&gt;&lt;br&gt;64%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="713.5" y="220" width="122.5" height="34" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;b&gt;Q4&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="719.5" y="410" width="110.5" height="18" as="geometry"/></mxCell>
        <mxCell id="c62" value="&lt;b&gt;By invoice date,&lt;/b&gt; 64% of the proposal&#x27;s discount reaches Q4. &lt;b&gt;By order date&lt;/b&gt; the same discount puts 51% there." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="212" width="186" height="140" as="geometry"/></mxCell>
        <mxCell id="c63" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="441" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c64" value="Months in which its lines were ordered" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="438" width="211.4" height="20" as="geometry"/></mxCell>
