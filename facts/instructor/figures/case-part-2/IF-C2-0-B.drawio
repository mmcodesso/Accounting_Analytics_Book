        <mxCell id="c67" value="&lt;b&gt;Q4&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="727.5" y="456" width="102.5" height="18" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;By invoice date,&lt;/b&gt; 64% of the proposal&#x27;s discount reaches Q4. &lt;b&gt;By order date&lt;/b&gt; the same discount puts 51% there." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="258" width="212" height="140" as="geometry"/></mxCell>
