        <mxCell id="c66" value="Months in which they were invoiced" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="273.4" y="438" width="196.736" height="20" as="geometry"/></mxCell>
