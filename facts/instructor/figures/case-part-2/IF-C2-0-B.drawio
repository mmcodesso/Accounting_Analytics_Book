        <mxCell id="e75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#B03A2E;strokeWidth=2;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 3;" edge="1" parent="1" source="c73" target="c74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c76" value="Recorded end date" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390.08" y="484" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="c77" value="&lt;i&gt;The number in a month is its count of lines. Harbor&#x27;s recorded dates run from 2026-03-01 to 2026-02-28, so the end falls 1 day before the start, yet its lines were ordered in March and April. Orders and invoices can occur in the same month; invoice activity also continues after the order window. The discount is billed with the invoice: Furniture&#x27;s orders of September and October are invoiced through December, which puts 68% of its discount in the fourth quarter.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="512" width="860" height="53" as="geometry"/></mxCell>
