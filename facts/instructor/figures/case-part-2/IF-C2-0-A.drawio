        <mxCell id="c52" value="each exhibit is cited in the memo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="442" y="374" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;i&gt;Requirements 2 to 5 each supply the section named in their perspective; the arrows into a section show which requirements it draws on. Requirement 6 writes the opening and the recommendation and assembles the appendix. Requirement 2 makes Exhibits 1 and 2, Requirement 3 Exhibit 3, Requirement 4 Exhibit 4 and Requirement 5 Exhibit 5.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="544" width="860" height="50" as="geometry"/></mxCell>
