        <mxCell id="c69" value="&lt;b&gt;5&lt;/b&gt;  The findings with their dispositions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="704" y="296" width="134" height="56" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;Requirement 5&lt;/b&gt;&lt;br&gt;Reconciliations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="568" y="303" width="116" height="42" as="geometry"/></mxCell>
        <mxCell id="e71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c70" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c72" value="&lt;i&gt;Each section is built from the requirements named beside it, and each exhibit is a visual of the report page named beside it, made in the requirement that owns that page. The auditing section rests on Requirement 5&#x27;s reconciliations and on the controls of Requirement 1&#x27;s own pages, Validation and About. The opening is written once the rest is known, and the recommendation rests on Requirements 2 to 5. Block heights are schematic.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="386" width="860" height="53" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
