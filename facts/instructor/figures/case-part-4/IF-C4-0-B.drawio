        <mxCell id="c11" value="&lt;i&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2027-03-01&lt;/span&gt;&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="738" y="183" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;Periods 78 and 79: open&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#B03A2E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="141.289" y="200" width="162.4" height="22" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#5D6D7E;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="176.628" y="142" width="1.5" height="36" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Last payroll posting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-18&lt;/span&gt;&lt;br&gt;PayrollSummary and PayrollPayment" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="ellipse;html=1;fillColor=#5D6D7E;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170.378" y="171" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="293.917" y="142" width="1.5" height="36" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;Data Through&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-31&lt;/span&gt;&lt;br&gt;the earliest of the last posting dates of the seven documents behind the working-capital accounts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="236" y="57" width="252" height="85" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="ellipse;html=1;fillColor=#1A5276;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="287.667" y="171" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="781.117" y="142" width="1.5" height="36" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;Last posting in the ledger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2027-02-23&lt;/span&gt;&lt;br&gt;supplier payments only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="87" width="196" height="55" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="ellipse;html=1;fillColor=#8A5D00;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="774.867" y="171" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c22" value="The last two pay periods (&lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-14&lt;/span&gt; to &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-31&lt;/span&gt;) are marked Open and have no registers, so payroll stops at &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-18&lt;/span&gt;. A Data Through that followed payroll would fall before the year-end and blank the last quarter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="230" width="276" height="80" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="307.689" y="210" width="474.178" height="2" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="307.689" y="202" width="2" height="18" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="779.867" y="202" width="2" height="18" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;263 supplier payments of 2026&#x27;s invoices&lt;/b&gt;, 271,327.17 in 526 ledger rows: the only postings after the year. Cash reads 8,442,255.80 at the year-end and 8,170,928.63 at the last posting, a fall of 271,327.17 that only means the data stop." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="313.689" y="230" width="468.178" height="64" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;i&gt;One axis from December 2026 to the end of February 2027. &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-31&lt;/span&gt; is the earliest of the last posting dates of SalesInvoice, CashReceiptApplication, PurchaseInvoice, GoodsReceipt, MaterialIssue, Shipment and DisbursementPayment: six documents end on that day and supplier payments run on to &lt;span style=&quot;white-space:nowrap&quot;&gt;2027-02-23&lt;/span&gt;. Payroll liability remittances post until &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-12-30&lt;/span&gt;, but the last payroll posting is the last PayrollSummary or PayrollPayment. Data Through is a bound observed in the extract, not proof that no document before it is missing.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="320" width="860" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
