        <mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#2C3E50;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c85" value="&lt;b&gt;Cash conversion cycle&lt;/b&gt;&lt;br&gt;173.7 to 425.7 days" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C3E50;strokeWidth=3;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="704" y="81.108" width="144" height="53" as="geometry"/></mxCell>
        <mxCell id="c86" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="662.333" y="82.912" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c87" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="704" y="56.108" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#B03A2E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c86" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c89" value="&lt;b&gt;DIO&lt;/b&gt;&lt;br&gt;229.9 to 469.8 days" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="704" y="37.108" width="144" height="38" as="geometry"/></mxCell>
        <mxCell id="c90" value="&lt;b&gt;2024-Q4 is the first quarter with a full twelve months, and its balances still carry the opening entry JE-2024-000001.&lt;/b&gt; Its receivables of 380,000.00 and payables of 2,096,371.12 have no document behind them in the extract. Without those lines DSO reads 57.4 days, not 62.2, and DPO 66.2, not 118.4." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="382" width="860" height="44" as="geometry"/></mxCell>
        <mxCell id="c91" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="382" width="5" height="44" as="geometry"/></mxCell>
        <mxCell id="c92" value="&lt;i&gt;From 2024-Q4 to 2026-Q4 DIO rose 239.9 days and the cycle 252.0, while DSO moved −7.3 and DPO −19.5: the cycle grew mainly through inventory. Each line is a quarter-end balance over its own ledger flow of the twelve months before, times 365; the shaded quarter is the first. DPO&#x27;s fall from 118.4 comes mostly from the unsupported opening payables diluted by purchases (66.2 without them).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="860" height="53" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
