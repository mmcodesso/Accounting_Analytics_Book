        <mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.415761;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c52" value="each exhibit is cited in the memo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="442" y="348" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;i&gt;Requirements 2 to 5 each supply the section named in their perspective, and the arrows into a section show which requirements it draws on. Requirement 6 writes the opening and the recommendation and assembles the appendix. Requirement&amp;nbsp;2 makes Exhibits&amp;nbsp;1 and 2, Requirement&amp;nbsp;3 makes Exhibit&amp;nbsp;3, Requirement&amp;nbsp;4 makes Exhibit&amp;nbsp;4, and Requirement&amp;nbsp;5 makes Exhibit&amp;nbsp;5. Requirement 1 supplies no section: it is the file every exhibit is read from, and its Tests tab is what the memo&#x27;s report controls rest on.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="570" width="860" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
