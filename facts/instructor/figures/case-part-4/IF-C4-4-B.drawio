        <mxCell id="c27" value="&lt;b&gt;941,310.30&lt;/b&gt;&lt;br&gt;cash from 9,383,566.10 to 8,442,255.80" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230.553" y="264" width="629.447" height="42" as="geometry"/></mxCell>
