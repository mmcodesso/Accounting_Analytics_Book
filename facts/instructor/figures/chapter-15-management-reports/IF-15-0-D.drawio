        <mxCell id="c45" value="&lt;b&gt;Static budget&lt;/b&gt;&lt;br&gt;The year&#x27;s operating expense budget, with the commission budget calculated on the budget&#x27;s sales volume" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="63" y="364" width="147.2" height="134" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;b&gt;Volume effect&lt;/b&gt;&lt;br&gt;The commission budget restated at the volume actually billed: Chapter 7&#x27;s flexible budget on one cost" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220.2" y="364" width="147.2" height="134" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;b&gt;Classification effect&lt;/b&gt;&lt;br&gt;Depreciation budgeted in Administration, booked partly in Warehouse: one up, one down by the same amount, net 0.00" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="377.4" y="364" width="147.2" height="134" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;b&gt;Remaining variance&lt;/b&gt;&lt;br&gt;The payroll burden rate, budgeted above the actual, and the months with three pay dates" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="534.6" y="364" width="147.2" height="134" as="geometry"/></mxCell>
