        <mxCell id="c50" value="&lt;b&gt;12%: 34.2%&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="472.718" y="178.602" width="91.364" height="22" as="geometry"/></mxCell>
