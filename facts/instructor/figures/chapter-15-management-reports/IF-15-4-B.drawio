        <mxCell id="c52" value="&lt;b&gt;15%: 46.7%&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="587.318" y="138.473" width="91.364" height="22" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;Measured lifts in the promotion months&lt;/b&gt;&lt;br&gt;−20.7% to +11.9%, the Part II case: none unusual" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="461.1" y="291.903" width="298.504" height="42" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;Reading the chart.&lt;/b&gt; Above the line the promotion pays for itself. Even 5 percent needs about the largest lift ever measured, 11.9%; the 12 percent of the promotion as it ran needs 34.2%, 2.9 times that." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="76" y="72.4" width="340" height="74" as="geometry"/></mxCell>
        <mxCell id="c55" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="76" y="72.4" width="5" height="74" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;i&gt;Each point is the Break-even Lift of the model answer at a whole-number discount, from 561.74 units, $416.23 price before discount, $215.99 standard cost a unit and a commission rate of 1.903%. Markers: the five discounts of Requirement 4; the larger one is the 12 percent the promotion ran at. The band is the lowest to the highest lift of the Part II case&#x27;s 9 promotions; the lift is a condition, not a forecast.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="474" width="860" height="53" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
