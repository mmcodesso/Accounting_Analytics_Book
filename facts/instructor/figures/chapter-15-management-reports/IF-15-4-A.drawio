        <mxCell id="c65" value="51.4%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="118" y="514" width="132" height="22" as="geometry"/></mxCell>
        <mxCell id="c66" value="17" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="22" y="536" width="96" height="22" as="geometry"/></mxCell>
        <mxCell id="c67" value="56.5%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="118" y="536" width="132" height="22" as="geometry"/></mxCell>
        <mxCell id="c68" value="18" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="22" y="558" width="96" height="22" as="geometry"/></mxCell>
        <mxCell id="c69" value="61.9%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="118" y="558" width="132" height="22" as="geometry"/></mxCell>
        <mxCell id="c70" value="19" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="22" y="580" width="96" height="22" as="geometry"/></mxCell>
        <mxCell id="c71" value="67.6%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="118" y="580" width="132" height="22" as="geometry"/></mxCell>
        <mxCell id="c72" value="20" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="22" y="602" width="96" height="22" as="geometry"/></mxCell>
        <mxCell id="c73" value="73.8%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="118" y="602" width="132" height="22" as="geometry"/></mxCell>
        <mxCell id="c79" value="&lt;b&gt;The cards follow the slider.&lt;/b&gt; Discount Value is the slider&#x27;s value, 12, and Break-even Lift is the contribution a unit earns without the discount over the contribution it earns with it, less one: $192.32 ÷ $143.32 − 1 = 34.2%." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="114" width="574" height="59" as="geometry"/></mxCell>
        <mxCell id="c80" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="114" width="5" height="59" as="geometry"/></mxCell>
        <mxCell id="c81" value="&lt;b&gt;The table does not.&lt;/b&gt; Each of its rows carries its own discount, so the page sets the slider&#x27;s interaction with the table to None (Format &gt; Edit interactions). Without that, the slider would cut the table to one row." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="185" width="574" height="44" as="geometry"/></mxCell>
        <mxCell id="c82" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="185" width="5" height="44" as="geometry"/></mxCell>
        <mxCell id="c83" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="250" y="282.25" width="26" height="1.5" as="geometry"/></mxCell>
        <mxCell id="c84" value="&lt;b&gt;5 percent&lt;/b&gt; needs 11.9%, about the largest lift measured in any promotion&#x27;s months (+11.9%): the evidence of Requirement 5." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="276" y="261" width="568" height="44" as="geometry"/></mxCell>
        <mxCell id="c85" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="276" y="261" width="5" height="44" as="geometry"/></mxCell>
        <mxCell id="c86" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="250" y="436.25" width="26" height="1.5" as="geometry"/></mxCell>
        <mxCell id="c87" value="&lt;b&gt;12 percent&lt;/b&gt; needs 34.2%: the card&#x27;s value, and the lift of the Part II case." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="276" y="422.5" width="568" height="29" as="geometry"/></mxCell>
        <mxCell id="c88" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="276" y="422.5" width="5" height="29" as="geometry"/></mxCell>
        <mxCell id="c89" value="&lt;b&gt;One promotion, one year.&lt;/b&gt; The three unit cards are scoped by name to the Design Trade Customer Promotion and to 2026, 88 invoice lines." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#F2F3F4;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="536" width="574" height="44" as="geometry"/></mxCell>
        <mxCell id="c90" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#5D6D7E;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="536" width="5" height="44" as="geometry"/></mxCell>
        <mxCell id="c91" value="Ex 15.3" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="4" y="650" width="62.692" height="24" as="geometry"/></mxCell>
        <mxCell id="c92" value="&lt;b&gt;Ex 15.4&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=2;fontColor=#1A5276;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="68.692" y="650" width="63.364" height="24" as="geometry"/></mxCell>
        <mxCell id="c93" value="Ex 15.5" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="134.056" y="650" width="62.692" height="24" as="geometry"/></mxCell>
        <mxCell id="c94" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="198.748" y="650" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="c95" value="&lt;i&gt;Report view, page Ex 15.4, with the slider at its default of 12. The slider is drawn as a track with one handle; Desktop draws its own. The table lists every whole discount from 0 to 20, each carrying Break-even Lift. Outlined: the five discounts of Requirement 4. Total rows are not drawn, and neither is the page&#x27;s text box.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="860" height="53" as="geometry"/></mxCell>
