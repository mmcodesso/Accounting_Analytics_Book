        <mxCell id="c65" value="&lt;b&gt;A hindcast.&lt;/b&gt; The chart stops in September 2026, so the quarter that follows is already known. The forecast is fit on 33 months, and its three points are compared with the actual 2026-Q4." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="284" y="330" width="275" height="74" as="geometry"/></mxCell>
        <mxCell id="c66" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="284" y="330" width="5" height="74" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;Not drawn: the forecast&#x27;s values.&lt;/b&gt; Desktop computes the forecast and its 95 percent interval inside the chart, so no measure and no file can return them. The band marks where they appear; Requirement 3 reads the points from the tooltips." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="569" y="330" width="275" height="104" as="geometry"/></mxCell>
