        <mxCell id="c7" value="&lt;b&gt;Exercise&amp;nbsp;15.3&lt;/b&gt; The three plant measures for each year, the manufacturing labor cost and the straight-time rate, and the order of the parameter&#x27;s fields" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="212" width="336" height="70" as="geometry"/></mxCell>
