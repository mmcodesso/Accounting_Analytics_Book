        <mxCell id="e71" value="CustomerID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.154088;entryDx=0;entryDy=0;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e72" value="SalesOrderID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c73" value="&lt;i&gt;One square is one order line; each row lines up with its order.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="650" y="322" width="210" height="34" as="geometry"/></mxCell>
        <mxCell id="c74" value="&lt;i&gt;The join meets each order with its customer and each line with its order, so the customer is carried once for every line.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="118" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;b&gt;The joined result&lt;/b&gt; &lt;i&gt;(Customer, SalesOrder and SalesOrderLine, joined on the two keys)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="368" width="470" height="20" as="geometry"/></mxCell>
