        <mxCell id="c98" value="&lt;b style=&quot;font-size:24px&quot;&gt;33&lt;/b&gt;&lt;br&gt;rows in the result" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="368" width="180" height="74" as="geometry"/></mxCell>
        <mxCell id="c99" value="&lt;b style=&quot;font-size:24px&quot;&gt;1&lt;/b&gt;&lt;br&gt;customer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="368" width="180" height="74" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b&gt;Summing line amounts by line is right:&lt;/b&gt; each line appears once, so the total is the customer&#x27;s. &lt;b&gt;Counting customers by row is wrong:&lt;/b&gt; it finds 33 where there is 1. Count distinct CustomerID, or aggregate at the grain you mean." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="454" width="380" height="74" as="geometry"/></mxCell>
        <mxCell id="c101" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="454" width="5" height="74" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;i&gt;Customer 148, Santos-Salazar: 12 orders and 33 lines. The amber cells show the one customer&#x27;s name repeated once for every line.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="578" width="860" height="36" as="geometry"/></mxCell>
