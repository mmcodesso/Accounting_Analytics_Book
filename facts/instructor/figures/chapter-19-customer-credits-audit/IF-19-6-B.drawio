        <mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#B03A2E;strokeWidth=2;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c85" value="&lt;b&gt;No deviation at all&lt;/b&gt; has a probability of 3.1e-09. Its upper limit, 4.95%, is the only one at or below the 5% tolerable rate." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="128" width="224" height="74" as="geometry"/></mxCell>
