        <mxCell id="c78" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="563.097" y="98" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#8A5D00;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;rounded=0;" edge="1" parent="1" source="c77" target="c78"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="313.548" y="88"/><mxPoint x="563.097" y="88"/></Array></mxGeometry></mxCell>
        <mxCell id="c80" value="&lt;b&gt;93% of draws find 10 to 19 deviations&lt;/b&gt;: the chance of fewer is 4.1% and of more 3.3%. A draw expects 14.3." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="178.323" y="48" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="c81" value="&lt;b&gt;The model answer&#x27;s frozen draw&lt;/b&gt; finds 14 deviations (23.7% of the draw), an upper limit of 34.6%." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="604" y="128" width="232" height="59" as="geometry"/></mxCell>
        <mxCell id="c82" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="604" y="157.5" width="1" height="1" as="geometry"/></mxCell>
