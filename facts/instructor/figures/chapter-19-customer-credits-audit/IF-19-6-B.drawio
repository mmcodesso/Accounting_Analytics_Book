        <mxCell id="e104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#8A5D00;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c102" target="c103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c105" value="&lt;i&gt;Upper deviation limit at that count,&lt;br&gt;95% confidence&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="442" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="c106" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="495" width="22" height="14" as="geometry"/></mxCell>
        <mxCell id="c107" value="Draws inside the range" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="492" width="130.712" height="20" as="geometry"/></mxCell>
        <mxCell id="c108" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#5D6D7E;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="176.712" y="495" width="22" height="14" as="geometry"/></mxCell>
        <mxCell id="c109" value="Draws outside it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="204.712" y="492" width="93.356" height="20" as="geometry"/></mxCell>
        <mxCell id="c110" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="316.068" y="495" width="22" height="14" as="geometry"/></mxCell>
        <mxCell id="c111" value="The frozen draw" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="344.068" y="492" width="94.7" height="20" as="geometry"/></mxCell>
        <mxCell id="c112" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456.768" y="495" width="22" height="14" as="geometry"/></mxCell>
        <mxCell id="c113" value="The plausible range" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="484.768" y="492" width="113.384" height="20" as="geometry"/></mxCell>
        <mxCell id="c114" value="&lt;i&gt;The distribution of the deviations in a draw of 59 (the sample size) from the 215 remaining refunds, 52 of which are dated before the last application of the customer&#x27;s payments, as the sheet computes it (a hypergeometric distribution; the shaded range is the tightest with each tail below 5%). For draws in the highlighted 10 to 19 deviation range, about 93% of draws, the upper limit is approximately 27% to 44%, far above the 5% tolerable rate. A draw with no deviation has a 4.95% upper limit but is extremely unlikely, and its bar is a sliver, too thin to see. The test of the whole remainder establishes its observed deviation rate without sampling uncertainty.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="860" height="83" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
