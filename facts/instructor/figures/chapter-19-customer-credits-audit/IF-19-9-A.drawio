        <mxCell id="c234" value="&lt;b&gt;The reconciliation by year&lt;/b&gt;&lt;br&gt;&lt;i&gt;sheet Reconciliation&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="671.99" y="152" width="168" height="44" as="geometry"/></mxCell>
