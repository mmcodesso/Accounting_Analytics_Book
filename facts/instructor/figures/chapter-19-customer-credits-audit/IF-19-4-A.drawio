        <mxCell id="c67" value="&lt;b&gt;Last receipt&lt;/b&gt;&lt;br&gt;The last receipt, &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-04-17&lt;/span&gt;, is the refund&#x27;s own date: not counted" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="536" width="568" height="36" as="geometry"/></mxCell>
        <mxCell id="c68" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="228" y="596" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c69" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="228" y="606" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c71" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="272" y="596" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c72" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="272" y="606" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="c71" target="c72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c74" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="228" y="606" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="c75" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="272" y="606" width="1" height="1" as="geometry"/></mxCell>
        <mxCell id="e76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="c74" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c77" value="&lt;b&gt;The same day, the order unknown&lt;/b&gt;&lt;br&gt;A receipt and a refund of &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-04-17&lt;/span&gt;: the records hold dates and not times, so which came first is unknown" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="590" width="568" height="36" as="geometry"/></mxCell>
        <mxCell id="c78" value="" style="ellipse;html=1;fillColor=#117A65;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="681" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c79" value="A receipt, by its ReceiptDate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="678" width="161.392" height="20" as="geometry"/></mxCell>
        <mxCell id="c80" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#117A65;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="198.392" y="680" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c81" value="An application of it to the invoice, by its ApplicationDate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="221.392" y="678" width="304.144" height="20" as="geometry"/></mxCell>
        <mxCell id="c82" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="541.536" y="681" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c83" value="The refund" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="563.536" y="678" width="68.032" height="20" as="geometry"/></mxCell>
        <mxCell id="c84" value="&lt;i&gt;Refund RF-2025-000081 of 246.58 is the first of the 7 refunds that the last-application reading counts and the last-receipt reading does not (the 58 and 51 of Requirement 4) whose invoice has two receipts applied a day or two after each. Its credit, CM-2025-000221, was approved before the second receipt and posted to 2060, so the refund can come before the payment it depends on. No table holds the date a payment cleared the bank, so none of the three readings can say when the money was usable.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="706" width="860" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
