        <mxCell id="c50" value="The credit approver does not handle that customer&#x27;s cash" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="505" width="316" height="40" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;i&gt;Cash handled outside the system (mail opening, deposits, remittance advices).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="505" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="c52" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="545" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;C5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="554" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c54" value="A clawback for every credit line at the accrual&#x27;s rate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="547" width="316" height="40" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;i&gt;Whether the representatives were informed; the approval of the rates beyond their end date.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="547" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="c56" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="587" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c57" value="&lt;b&gt;C6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="596" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c58" value="Refunds approved within authority, outside customer service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="589" width="316" height="40" as="geometry"/></mxCell>
        <mxCell id="c59" value="&lt;i&gt;The delegation of authority for refunds; who prepared the refund (no preparer column).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="589" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="c60" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="629" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;b&gt;C7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="630.5" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c62" value="A refund only of a credit balance the customer has paid" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="631" width="316" height="25" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;i&gt;Whether a payment had cleared the bank; the customer&#x27;s request for the refund.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="631" width="488" height="25" as="geometry"/></mxCell>
        <mxCell id="c64" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="656" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;C8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=2.5;dashed=1;dashPattern=3 2;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="665" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c66" value="Refunds to the payer&#x27;s own method or account, net of open balances" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="658" width="316" height="40" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;i&gt;The payee&#x27;s name, the bank account, and the customer&#x27;s written request: no table holds them.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="658" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="c68" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="698" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;C9&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="707" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="c70" value="Cash applied promptly to the remitting customer&#x27;s invoices" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="34" y="700" width="316" height="40" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;i&gt;Remittance advices and bank deposit records.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="700" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="c72" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="740" width="826" height="1" as="geometry"/></mxCell>
        <mxCell id="c73" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="756" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="c74" value="The records evidence part of it: the rest is written beside the badge" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="756" width="366.84" height="22" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=2.5;dashed=1;dashPattern=3 2;fontColor=#2C3E50;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="408.84" y="756" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="c76" value="The evidence lies outside the database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="436.84" y="756" width="220.116" height="22" as="geometry"/></mxCell>
