        <mxCell id="c43" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="0" y="53" width="22" height="14" as="geometry"/></mxCell>
        <mxCell id="c44" value="A query with Enable load cleared" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="280" height="20" as="geometry"/></mxCell>
