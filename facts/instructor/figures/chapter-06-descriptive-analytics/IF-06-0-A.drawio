        <mxCell id="c1" value="&lt;b&gt;Invoice lines of fiscal 2026&lt;/b&gt;&lt;br&gt;&lt;b&gt;$29,756,420.08&lt;/b&gt;&lt;br&gt;InvoiceLines: the control total of the Profile worksheet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="340" height="70" as="geometry"/></mxCell>
