        <mxCell id="c49" value="&lt;i&gt;Copy with Headers or Export to CSV, unrounded&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="222" y="495" width="96" height="58" as="geometry"/></mxCell>
        <mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c51" value="&lt;i&gt;A Table of item costs, one row per item&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="542" y="495" width="96" height="58" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;b&gt;The memo to the CFO and the production manager&lt;/b&gt; (Requirement 10): at most two pages, with the decision table, and at most three pages of exhibits.&lt;br&gt;Every number in it traces to one of the three files." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="647" width="860" height="52" as="geometry"/></mxCell>
        <mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.127907;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.872093;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c56" value="&lt;i&gt;Each card is a requirement of the case, in the order of its four phases; the tags name the tools it uses (Requirement 4 builds its item costs with Power Query inside Excel). The teal boxes are the four milestones an instructor may collect and check. Arrows show how results move: Copy with Headers or Export to CSV from the script into the workbook, the workbook&#x27;s Table of item costs into the explorer, and all three files into the memo.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="709" width="860" height="53" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
