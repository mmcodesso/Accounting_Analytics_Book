        <mxCell id="c111" value="&lt;i&gt;Rows 17 and below: the plan&#x27;s figures against the records, the revised standards, the stock and its revaluation, and the model answer&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#5D6D7E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="0" y="458" width="859" height="24" as="geometry"/></mxCell>
