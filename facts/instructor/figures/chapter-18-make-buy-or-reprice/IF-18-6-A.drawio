        <mxCell id="c80" value="&lt;i&gt;Rows 16 to 56: the Goal Seek block, the families to buy, the two-way Data Table and the materials the families draw&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#5D6D7E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="0" y="305" width="860" height="22" as="geometry"/></mxCell>
