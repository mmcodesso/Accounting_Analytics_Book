        <mxCell id="c17" value="&lt;b&gt;The whole paths compared&lt;/b&gt;&lt;br&gt;Make and reprice against buy and reprice the rest, with the one-time costs shown." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="326" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="The Memo sheet and&lt;br&gt;Requirement 8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="274" width="140" height="36" as="geometry"/></mxCell>
