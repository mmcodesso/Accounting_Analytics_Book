        <mxCell id="c31" value="&lt;b&gt;Exhibit 1&lt;/b&gt;&lt;br&gt;The family costs under the three views" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="586" y="50" width="268" height="74" as="geometry"/></mxCell>
