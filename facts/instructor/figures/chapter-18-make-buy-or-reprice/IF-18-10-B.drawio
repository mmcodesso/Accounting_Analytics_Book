        <mxCell id="c35" value="&lt;b&gt;Exhibit 2&lt;/b&gt;&lt;br&gt;The make-or-buy table, with the break-even quotes and the two-way table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="586" y="180" width="268" height="74" as="geometry"/></mxCell>
