        <mxCell id="c43" value="&lt;b&gt;Standards&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="766.04" y="392" width="74.68" height="22" as="geometry"/></mxCell>
        <mxCell id="c44" value="Each exhibit is cited in the memo by name, with its sheet and the date of its assumptions, and supports a number the memo states. Keep the summaries on the last page legible and the detailed sheets for traceability. The decision table of the Memo sheet goes with the memo, in its third section." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="436" width="280" height="119" as="geometry"/></mxCell>
        <mxCell id="c45" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="436" width="5" height="119" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;i&gt;Left: the seven sections of the model memo in their order, each with the requirements that supply its evidence. Right: the appendix, at most three pages, each exhibit tagged with the sheet of Make Buy Reprice.xlsx it comes from.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="550" width="860" height="38" as="geometry"/></mxCell>
