        <mxCell id="c25" value="&lt;b&gt;The standards and the statements&lt;/b&gt;&lt;br&gt;A rate on normal capacity for inventory, and the evidence the base year&#x27;s statements need before anything is restated." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="326" height="60" as="geometry"/></mxCell>
