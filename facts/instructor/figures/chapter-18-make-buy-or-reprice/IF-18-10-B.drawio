        <mxCell id="c39" value="&lt;b&gt;Exhibit 3&lt;/b&gt;&lt;br&gt;The capacity, price and standards results" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="586" y="310" width="268" height="74" as="geometry"/></mxCell>
        <mxCell id="c40" value="Sheet:" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="588" y="391" width="44" height="22" as="geometry"/></mxCell>
