<mxfile host="Electron" version="29.6.6">
  <diagram name="The Page Plan of the Memo and Its Appendix" id="IF-18-10-B">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="590" background="#FFFFFF" math="0" shadow="0">
