        <mxCell id="c28" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="8" y="496" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;The production manager&#x27;s decision&lt;/b&gt;&lt;br&gt;Whether, and how fast, to reduce the crew to the work the plant has: left to the production manager." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="484" height="60" as="geometry"/></mxCell>
