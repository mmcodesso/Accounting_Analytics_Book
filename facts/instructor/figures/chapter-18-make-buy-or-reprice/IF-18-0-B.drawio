<mxfile host="Electron" version="29.6.6">
  <diagram name="The Same Inputs, Three Costing Views" id="IF-18-0-B">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="462" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="462" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;The year&#x27;s inputs to account 1090: $5,427,932.83&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="138" y="0" width="720" height="20" as="geometry"/></mxCell>
        <mxCell id="c2" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="138" y="24" width="1.5" height="12" as="geometry"/></mxCell>
        <mxCell id="c3" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="856.5" y="24" width="1.5" height="12" as="geometry"/></mxCell>
        <mxCell id="c4" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="138" y="24" width="720" height="1.5" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Standard&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="128" height="22" as="geometry"/></mxCell>
        <mxCell id="c6" value="What the standards release to the products" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="72" width="128" height="52" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Actual absorption&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="128" height="22" as="geometry"/></mxCell>
        <mxCell id="c8" value="In concept, every dollar of the inputs on the units made" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="192" width="128" height="52" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Time-driven&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="128" height="22" as="geometry"/></mxCell>
        <mxCell id="c10" value="What the products&#x27; routing time used, and the capacity left over" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="312" width="128" height="52" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Released at standard&lt;/b&gt;&lt;br&gt;$3,266,422.54" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="138" y="50" width="433.282" height="54" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;The rest: the variance&lt;/b&gt;&lt;br&gt;$2,161,510.29" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="571.282" y="50" width="286.718" height="54" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;i&gt;The standards charge the products only what they release; the rest waits in 1090 until each work order&#x27;s close sends it to account 5080.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="138" y="108" width="720" height="34" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Every dollar spread over the units made&lt;/b&gt;&lt;br&gt;$5,427,932.83, or $78.77 a standard hour over 68,913 standard hours completed" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="138" y="170" width="720" height="54" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;i&gt;In concept nothing is left over, so the idle capacity and the supervision sit in the products&#x27; cost. The case approximates it with each family&#x27;s closed variance per unit completed.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="138" y="228" width="720" height="34" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;The products&#x27; conversion&lt;/b&gt;&lt;br&gt;$4,259,206.41" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="138" y="290" width="564.972" height="54" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;The crew&lt;/b&gt;&lt;br&gt;$997,573.76" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="702.972" y="290" width="132.325" height="54" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="835.297" y="290" width="22.7029" height="54" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="702.972" y="278" width="155.028" height="1.5" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="702.972" y="278" width="1.5" height="9" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C3E50;strokeColor=#2C3E50;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="856.5" y="278" width="1.5" height="9" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;Unused capacity, the plant&#x27;s cost: $1,168,726.42&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="388" y="256" width="470" height="20" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;i&gt;29,243.7 practical hours the routings did not use, at $39.97 an hour. The crew&#x27;s part is the darker segment; the light segment, $171,152.66, is supervision and equipment.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="138" y="348" width="720" height="34" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="397" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c25" value="Charged to the products" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="394" width="136.736" height="20" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#B03A2E;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="178.736" y="397" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c27" value="The variance, outside the product costs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="198.736" y="394" width="217.436" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438.172" y="397" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c29" value="Unused capacity (the crew&#x27;s part darker)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="458.172" y="394" width="223.028" height="20" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;i&gt;The three bars are the same $5,427,932.83 of fiscal 2026 inputs to 1090 (payroll, the Factory Overhead entries and depreciation), drawn to one scale. The standard view&#x27;s rest is the conversion variance the closes carry to 5080, $2,159,138.03, plus the year&#x27;s net change in 1090, $2,372.26.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="422" width="860" height="38" as="geometry"/></mxCell>
      </root>
