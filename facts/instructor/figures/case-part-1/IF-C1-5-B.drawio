        <mxCell id="c249" value="Revenue −$13,241,499.72&lt;br&gt;Cost of goods sold −$7,496,777.60&lt;br&gt;Margin 43.4%, about 2026 Q3&#x27;s 43.3%: a plausible ratio of two negative totals, because JE-2026-000296 is in the rows." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#FDEDEC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="34" width="270" height="89" as="geometry"/></mxCell>
