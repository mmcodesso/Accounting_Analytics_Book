        <mxCell id="c84" value="&lt;b&gt;main&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="354" width="62" height="22" as="geometry"/></mxCell>
        <mxCell id="c85" value="The group&#x27;s tables carry the evidence the model answer is built on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="68" y="354" width="380" height="22" as="geometry"/></mxCell>
        <mxCell id="c86" value="support" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=2;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="462" y="354" width="62" height="22" as="geometry"/></mxCell>
        <mxCell id="c87" value="Named in the answer for one point: a lookup, a check or a second source." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="530" y="348" width="330" height="34" as="geometry"/></mxCell>
        <mxCell id="c88" value="&lt;i&gt;Accounting Core is the main evidence in 5 of 6 exercises and Order-to-Cash (O2C) in 3. Master Data appears only as support. No exercise draws on Fixed Assets and Financing. A filled cell marks a group, not a count of tables: it can stand for one table or for six. Rows are the groups of Table 1.3; tables it does not list, such as the line tables and the work center tables, are placed by the dataset documentation.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="860" height="52" as="geometry"/></mxCell>
