        <mxCell id="c19" value="&lt;i&gt;The order and its lines post nothing: no arrow reaches the ledger from SalesOrder or SalesOrderLine, because no financial effect has happened yet.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="102" width="164" height="110" as="geometry"/></mxCell>
