        <mxCell id="c69" value="Plus and minus 3 percent of the expectation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="417.476" y="418" width="320" height="20" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;i&gt;Three of the twelve months are beyond the threshold; every other month is within 2.5%. The two consecutive flagged months differ in sign and nearly cancel, which a shift of commission from one month to the other would do; the records show the customer mix instead (Step 6). The axis includes zero, and each column starts there.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="448" width="860" height="53" as="geometry"/></mxCell>
