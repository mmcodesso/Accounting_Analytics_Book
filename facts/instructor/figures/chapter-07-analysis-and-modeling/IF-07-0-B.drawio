        <mxCell id="c49" value="&lt;b&gt;5% discount&lt;/b&gt;&lt;br&gt;needs a lift of 13.3%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="146.667" y="264.524" width="158" height="40" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;b&gt;10% discount: the promotion as it ran&lt;/b&gt;&lt;br&gt;needs a lift of 30.8%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#B03A2E;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="319.333" y="186.731" width="242" height="40" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;b&gt;15% discount&lt;/b&gt;&lt;br&gt;needs a lift of 54.6%" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="656" y="80.6178" width="158" height="40" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;i&gt;Above the line, the promotion pays for itself.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="82" y="83.8286" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;i&gt;Below the line, it does not.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="610.08" y="324.514" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;i&gt;From the Model worksheet&#x27;s inputs: 4,823.89 units on the promotion&#x27;s lines, $613.72 price before discount, $346.36 variable cost and a commission rate of 1.90%. The break-even lift is the lift at which the contribution with the discount equals the contribution without it; fixed costs do not enter. At the 10% discount the Furniture units ordered in the promotion&#x27;s months were +0.7% against the other months.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="436" width="860" height="53" as="geometry"/></mxCell>
