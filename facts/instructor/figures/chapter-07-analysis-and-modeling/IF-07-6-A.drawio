        <mxCell id="c71" value="A forecast equal to the orders" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="438" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c72" value="&lt;i&gt;In every product group the ratio is above 2 in every year and rises from 2024 to 2026; the four groups together run 2.33, 2.57 and 2.88. Services runs the other way, at 0.28 to 0.31, and is forecast and ordered in hours of design work, so it is kept apart and never added to product units. Every bar starts at zero.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="468" width="860" height="38" as="geometry"/></mxCell>
