        <mxCell id="c42" value="Ex B.2" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="116.032" y="400" width="57.352" height="24" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="175.384" y="400" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;i&gt;Report view, page Ex B.1, viewed as the Finance role, which has no rules and no column permission. The table is filtered to fiscal 2026: three job titles have manufacturing hours, and the other four have labor time that is all non-manufacturing, so their hours are blank and their cost is $382,650.93. The total row and the card agree on $3,344,393.44. The text box is the model answer&#x27;s note, cut to a few lines of each paragraph.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="860" height="53" as="geometry"/></mxCell>
