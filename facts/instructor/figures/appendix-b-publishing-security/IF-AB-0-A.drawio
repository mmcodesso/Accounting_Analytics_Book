<mxfile host="Electron" version="29.6.6">
  <diagram name="How Much of the Appendix to Teach" id="IF-AB-0-A">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="512" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="512" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Start&lt;/b&gt;: students have Power BI Desktop and the Charles River Reports project" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="283.75" y="0" width="440" height="46" as="geometry"/></mxCell>
        <mxCell id="c2" value="Do you and a partner have Pro or Premium Per User licenses and a shared workspace where you are Admin?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="353.75" y="86" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c3" value="Add the Publishing and Sharing section as reading, with Step 5 of Tutorial B.2 as a workshop?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="147.5" y="200" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Scope 1: Desktop security&lt;/b&gt;&lt;br&gt;Tutorial B.1, Exercises B.1 and B.2, questions 1, 3, 4, 5 and 8&lt;br&gt;&lt;i&gt;Needs:&lt;/i&gt; Desktop only&lt;br&gt;&lt;b&gt;Class time: about 100 minutes (Plan B)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="318" width="270" height="144" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Scope 2: Security and sharing as reading&lt;/b&gt;&lt;br&gt;Scope 1, the Publishing and Sharing section, Step 5 of Tutorial B.2, questions 2, 6 and 7&lt;br&gt;&lt;i&gt;Needs:&lt;/i&gt; Desktop only&lt;br&gt;&lt;b&gt;Class time: about 150 minutes (Plan A, workshop in session 2)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="295" y="318" width="270" height="144" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Scope 3: Full&lt;/b&gt;&lt;br&gt;Scope 2 plus Steps 1 to 4 of Tutorial B.2 with a colleague&lt;br&gt;&lt;i&gt;Needs:&lt;/i&gt; Pro or Premium Per User for both, and a shared workspace where you are Admin&lt;br&gt;&lt;b&gt;Class time: about 150 minutes (Plan A) plus 45 to 60 minutes of student time&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="318" width="270" height="144" as="geometry"/></mxCell>
