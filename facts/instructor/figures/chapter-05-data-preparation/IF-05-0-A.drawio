        <mxCell id="e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#B03A2E;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c59" value="A lookup toward the many side" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="62" y="390.5" width="240" height="23" as="geometry"/></mxCell>
        <mxCell id="c60" value="&lt;i&gt;The four tables are all in the Order-to-Cash group, so every relationship is a solid gray line. A lookup from a line to its invoice, or from an invoice to its order, finds exactly one row. An order can have several invoices (5,209 do) and several shipments (3,186 do), so a lookup of the order&#x27;s shipment date returns the first of them, 2026-01-31, and not 2026-02-05, without a message.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="494" width="860" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
