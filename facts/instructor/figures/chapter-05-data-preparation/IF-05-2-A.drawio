        <mxCell id="c225" value="NumberYearMatches is FALSE: the number year differs from the date (6 invoices)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="756" width="700" height="20" as="geometry"/></mxCell>
