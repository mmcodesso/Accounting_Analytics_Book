        <mxCell id="c58" value="&lt;b&gt;Reading 2026-Q4.&lt;/b&gt; The margin falls from 1,810,257.09 to 1,695,211.02, a decline of 115,046.07. The promotion effect, -120,687.02, is larger than the whole decline; volume, mix and price lists together add +5,640.95. Bridge Check reads 0.00 in every row: the four effects explain each quarter&#x27;s change." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="16" y="194" width="804" height="59" as="geometry"/></mxCell>
        <mxCell id="c59" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="16" y="194" width="5" height="59" as="geometry"/></mxCell>
        <mxCell id="c60" value="Ex 14.3" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="4" y="273" width="62.692" height="24" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;b&gt;Ex 14.4&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=2;fontColor=#1A5276;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="68.692" y="273" width="63.364" height="24" as="geometry"/></mxCell>
        <mxCell id="c62" value="Notes" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="134.056" y="273" width="53.344" height="24" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="189.4" y="273" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;i&gt;Report view, page Ex 14.4, the Furniture matrix, filtered to 2026 and Furniture; values as the format #,0.00 shows them. Outlined in coral: the 2026-Q4 row, with its promotion effect in amber, larger than the whole decline; in teal: Bridge Check, zero in every row. The Total row compares the whole year with the same dates moved back one quarter, so its effects are those of that comparison and not the sum of the rows; Bridge Check is still zero. The page holds a second matrix for Lighting and the model answer&#x27;s text box, not drawn here.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="303" width="860" height="68" as="geometry"/></mxCell>
        <mxCell id="c55" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="21" y="131" width="695" height="20" as="geometry"/></mxCell>
        <mxCell id="c56" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#8A5D00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="502" y="133" width="114" height="16" as="geometry"/></mxCell>
