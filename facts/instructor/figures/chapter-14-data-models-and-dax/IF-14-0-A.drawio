        <mxCell id="c1" value="&lt;b&gt;Chapter&amp;nbsp;13 report&lt;/b&gt;&lt;br&gt;Charles River Reports.pbix&lt;br&gt;Four queries: Customer, SalesInvoice, SalesInvoiceLine and Item&lt;br&gt;Pages: Sales and Discounts, Validation and Review" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="172" height="136" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Tutorial&amp;nbsp;14.1&lt;/b&gt;&lt;br&gt;Building the Sales Star and the Date Table&lt;br&gt;SalesInvoice is merged into the lines and stops loading; Customer, Item and the new Date table relate to the lines&lt;br&gt;&lt;i&gt;8 steps&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="201.333" y="0" width="200" height="136" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Tutorial&amp;nbsp;14.2&lt;/b&gt;&lt;br&gt;Writing and Testing the Margin Measures&lt;br&gt;The Key Measures table, from Revenue to Share of Revenue; the Margins page; the Tests tab&lt;br&gt;&lt;i&gt;9 steps&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430.667" y="0" width="200" height="136" as="geometry"/></mxCell>
