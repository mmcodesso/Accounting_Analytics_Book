        <mxCell id="c10" value="&lt;b&gt;Ex&amp;nbsp;14.1&lt;/b&gt;&lt;br&gt;The Balance Sheet at Any Month-End&lt;br&gt;&lt;br&gt;4 measures: Balance, two variants and Contra Accounts; the page Ex&amp;nbsp;14.1&lt;br&gt;&lt;br&gt;&lt;i&gt;Builds on: Tutorial&amp;nbsp;14.3: IsYearEndClose, GL Amount; Tutorial&amp;nbsp;14.1: the marked Date table&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="264" width="135" height="243" as="geometry"/></mxCell>
