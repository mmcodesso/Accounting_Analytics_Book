        <mxCell id="c53" value="Revenue&amp;nbsp;Own&amp;nbsp;=&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;CALCULATE&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SUM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&amp;nbsp;SalesInvoiceLine[LineTotal]&amp;nbsp;)&lt;br&gt;)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="594" y="204" width="258" height="76" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;SalesInvoiceLine&lt;/b&gt;&lt;br&gt;only the lines of the current customer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="594" y="340" width="258" height="64" as="geometry"/></mxCell>
        <mxCell id="c55" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="614" y="280" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#117A65;strokeWidth=2.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.0852713;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c57" value="&lt;b&gt;The current row becomes a filter&lt;/b&gt; on Customer, and the relationship carries it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="286" width="224" height="48" as="geometry"/></mxCell>
        <mxCell id="c58" value="&lt;b&gt;Each row reads its own number:&lt;/b&gt; that customer&#x27;s lines only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="594" y="428" width="258" height="52" as="geometry"/></mxCell>
        <mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c60" value="&lt;i&gt;A board sketch with no values, to draw while the class reads the three paragraphs of the section on evaluation context. The chapter&#x27;s figures on the filter context of a cell and on row context with and without context transition show the same ideas with the numbers.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="494" width="860" height="38" as="geometry"/></mxCell>
