        <mxCell id="c80" value="&lt;b&gt;Total&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="344" y="174" width="88" height="22" as="geometry"/></mxCell>
        <mxCell id="c81" value="&lt;b&gt;0.00&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="432" y="174" width="102" height="22" as="geometry"/></mxCell>
        <mxCell id="c82" value="&lt;b&gt;0.00&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="534" y="174" width="140" height="22" as="geometry"/></mxCell>
        <mxCell id="c83" value="&lt;b&gt;0.00&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="674" y="174" width="152" height="22" as="geometry"/></mxCell>
        <mxCell id="c86" value="&lt;b&gt;The ties at 2026-12.&lt;/b&gt; The matrix reads debits less credits and totals 0.00. Assets 39,328,524.11 equal liabilities 13,896,428.43 plus equity 20,928,484.44, their signs reversed, plus the year&#x27;s net income 4,503,611.24. Revenue and expense together read -4,503,611.24, so that net income is their balance with its sign reversed." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#E8F6F3;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="338" y="216" width="506" height="74" as="geometry"/></mxCell>
        <mxCell id="c87" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#117A65;strokeColor=#117A65;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="338" y="216" width="5" height="74" as="geometry"/></mxCell>
        <mxCell id="c88" value="&lt;b&gt;Reading the second matrix.&lt;/b&gt; Balance is the pre-closing balance sheet. At this year-end Balance with Closes is the post-closing one, because the ledger holds the year&#x27;s closes: revenue and expense read zero and the year&#x27;s income sits in equity. Balance on GL Amount leaves every close out, so income never reaches equity and revenue and expense hold all three years." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="338" y="304" width="506" height="89" as="geometry"/></mxCell>
        <mxCell id="c89" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="338" y="304" width="5" height="89" as="geometry"/></mxCell>
        <mxCell id="c90" value="Income Statement" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="4" y="592" width="119.38" height="24" as="geometry"/></mxCell>
        <mxCell id="c91" value="&lt;b&gt;Ex 14.1&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A5276;strokeWidth=2;fontColor=#1A5276;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="125.38" y="592" width="63.364" height="24" as="geometry"/></mxCell>
        <mxCell id="c92" value="Ex 14.2" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="190.744" y="592" width="62.692" height="24" as="geometry"/></mxCell>
        <mxCell id="c93" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="255.436" y="592" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="c94" value="&lt;i&gt;Report view, page Ex 14.1, with the slicer on 2026-12 and the rows of the first matrix expanded. Outlined in the first matrix: the total, zero. Outlined in the second: the three rows where the measures disagree. Equity reads -20,928,484.44, -25,432,095.68 and -10,683,821.46 in the three columns, and revenue and expense together -4,503,611.24, 0.00 and -14,748,274.22.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="622" width="860" height="53" as="geometry"/></mxCell>
