        <mxCell id="c48" value="&lt;b&gt;Price list effect&lt;/b&gt;&lt;br&gt;−units × change in the cut from list price to the price before discounts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456" y="362" width="121" height="102" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;b&gt;Promotion effect&lt;/b&gt;&lt;br&gt;−units × change in discount per unit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="587" y="362" width="121" height="102" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;b&gt;Gross Margin&lt;/b&gt;&lt;br&gt;of 2026-Q4: Margin PQ plus the four effects; Bridge Check is the difference, 0.00" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="718" y="362" width="121" height="102" as="geometry"/></mxCell>
