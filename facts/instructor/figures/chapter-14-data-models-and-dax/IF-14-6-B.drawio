        <mxCell id="c93" value="5 columns, 7 rows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="632" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c96" value="&lt;b&gt;In Report view, the formula bar of GL Amount: the tutorial&#x27;s (left) and with the closes kept (right)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="674" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c97" value="GL&amp;nbsp;Amount&amp;nbsp;=&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;CALCULATE&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SUM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&amp;nbsp;GLEntry[Debit]&amp;nbsp;)&amp;nbsp;-&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SUM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&amp;nbsp;GLEntry[Credit]&amp;nbsp;),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;GLEntry[IsYearEndClose]&amp;nbsp;=&amp;nbsp;FALSE&amp;nbsp;()&lt;br&gt;)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="700" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c98" value="GL&amp;nbsp;Amount&amp;nbsp;=&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SUM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&amp;nbsp;GLEntry[Debit]&amp;nbsp;)&amp;nbsp;-&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#1A5276&quot;&gt;SUM&lt;/font&gt;&lt;/b&gt;&amp;nbsp;(&amp;nbsp;GLEntry[Credit]&amp;nbsp;)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="420" height="44" as="geometry"/></mxCell>
        <mxCell id="c99" value="&lt;i&gt;The same tab after GL Amount keeps the closing entries, run again; the query is not touched, and the drawing leaves out its tests (lines 5 to 21, a gray bar). Outlined: the two tests that read GL Amount over every account, the net income of 2026 and the manufacturing variance, each with an Actual of 0 and a Difference of minus its expected value. The invoice lines and the revenue do not use GL Amount; the debit total uses SUM; the two ledger tests read sales invoice postings, which no closing entry touches. The right-hand formula is one way to write the change.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="804" width="860" height="68" as="geometry"/></mxCell>
        <mxCell id="c94" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="78" y="514" width="732" height="26" as="geometry"/></mxCell>
        <mxCell id="c95" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="78" y="558" width="732" height="26" as="geometry"/></mxCell>
