        <mxCell id="c115" value="&lt;b&gt;*&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="780" y="235" width="18" height="20" as="geometry"/></mxCell>
        <mxCell id="c116" value="&lt;b&gt;1&lt;/b&gt; the table that holds the key &amp;nbsp; &lt;b&gt;*&lt;/b&gt; the table that refers to it &amp;nbsp; &lt;b&gt;Solid&lt;/b&gt; an active relationship &amp;nbsp; &lt;b&gt;Dashed&lt;/b&gt; an inactive one, used only inside USERELATIONSHIP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="860" height="40" as="geometry"/></mxCell>
        <mxCell id="c117" value="&lt;i&gt;The filter arrow points from Date toward each fact table. ShippedLines reaches Date twice: the solid line from InvoiceDate answers by invoice date, and the dashed line from ShipmentDate answers by ship date when a measure asks for it.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="860" height="40" as="geometry"/></mxCell>
