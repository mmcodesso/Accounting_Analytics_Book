        <mxCell id="c80" value="The opening balance entry credited accounts payable with $2,096,371.12 on the conversion date, with no supplier invoices behind it. No payment has ever been applied to it (every payment pays an invoice). The same entry debited cash with exactly $2,096,371.12, a coincidence worth a question. Unsupported, like the opening receivables of Tutorial 8.2." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="28" y="487" width="520" height="69" as="geometry"/></mxCell>
        <mxCell id="c81" value="The ledger, unless the conversion-date supplier detail supports it" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="548" y="487" width="312" height="69" as="geometry"/></mxCell>
