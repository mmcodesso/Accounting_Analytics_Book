        <mxCell id="c83" value="Debt Reclass entry: the note-financed capital invoice V0005-2024-003160 ($360,000.00) was moved from 2010 to 2110 Notes Payable when a note financed it. No supplier payment will ever settle it, so it stays open in the invoice detail." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="28" y="556" width="520" height="54" as="geometry"/></mxCell>
