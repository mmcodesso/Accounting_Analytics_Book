        <mxCell id="c1" value="&lt;b&gt;JE-2024-000001&lt;/b&gt;&lt;br&gt;Opening balance entry, posted 2024-01-01&lt;br&gt;Created by the chief financial officer&lt;br&gt;18 ledger lines, $13,817,192.58 on each side" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=2.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="34" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Receivables reconciliation&lt;/b&gt;&lt;br&gt;Tutorial 8.2, Step 5&lt;br&gt;Account 1020 less the open invoices: &lt;b&gt;$380,000.00&lt;/b&gt;, the entry&#x27;s debit line to 1020" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="236" height="116" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Payables reconciliation&lt;/b&gt;&lt;br&gt;Exercise 8.2&lt;br&gt;Account 2010 less the open supplier invoices: &lt;b&gt;$2,096,371.12&lt;/b&gt;, the entry&#x27;s credit to 2010, balanced by a debit to cash of the same amount" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="624" y="20" width="236" height="116" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Journal entry tests&lt;/b&gt;&lt;br&gt;Tutorial 8.3, Steps 2 and 3&lt;br&gt;The only entry that scores four of five flags: Weekend, Backdated, SelfApproved, AboveLimit. Entry total &lt;b&gt;$13,817,192.58&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="265" y="206" width="330" height="100" as="geometry"/></mxCell>
