        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=2;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="&lt;b&gt;debit to&lt;br&gt;1020&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="236" y="38" width="54" height="34" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;credit to&lt;br&gt;2010&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="570" y="38" width="54" height="34" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;score four&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="436" y="154" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;i&gt;Three routes to one entry. The two reconciliations meet it as an unexplained difference, the journal entry tests as the highest risk score. The amounts are the entry&#x27;s own lines (the debit to 1020, the credit to 2010 and the matching debit to cash 1010) and its total. Amber: the entry; blue: the tests that reach it.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="324" width="860" height="38" as="geometry"/></mxCell>
