        <mxCell id="c33" value="&lt;b&gt;5 ≠ 4&lt;/b&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="236" y="18" width="46" height="18" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;b&gt;Agreement inside the import cannot reveal what both sides lack.&lt;/b&gt; The invoice and its lines were dropped together, so the two totals still agree and the difference is zero. Only evidence from outside the import, such as the row count of the source Table, shows that something is missing." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="282" width="860" height="44" as="geometry"/></mxCell>
