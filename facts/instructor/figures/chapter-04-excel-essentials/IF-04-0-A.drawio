        <mxCell id="c63" value="&lt;i&gt;fx&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#5D6D7E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="128" y="422" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="c64" value="=COUNTIFS(SalesInvoiceLine[&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;PricingMethod&lt;/b&gt;&lt;/font&gt;],$A16,SalesInvoiceLine[&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;Discount&lt;/b&gt;&lt;/font&gt;],C$15)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="162" y="422" width="698" height="28" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;Two ways to keep the columns where they are&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="468" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;Paste instead of filling.&lt;/b&gt; Copy the cell and paste it: structured references stay as they are." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;Lock the column&lt;/b&gt; by writing it with a column range, which a fill leaves alone:" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="512" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="c68" value="=COUNTIFS(SalesInvoiceLine[&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;[PricingMethod]:[PricingMethod]&lt;/b&gt;&lt;/font&gt;],$A16,SalesInvoiceLine[&lt;font color=&quot;#117A65&quot;&gt;&lt;b&gt;[Discount]:[Discount]&lt;/b&gt;&lt;/font&gt;],B$15)" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="34" y="536" width="826" height="28" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;i&gt;Teal outline and teal names (bold): the columns the formula means. Coral outline and coral names (bold): the columns it reads after a fill across. Click a cell in the middle of the result and read the formula bar: that is how a drift shows.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="574" width="860" height="36" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#117A65;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="38" y="58" width="104" height="98" as="geometry"/></mxCell>
        <mxCell id="c30" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#117A65;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="378" y="58" width="194" height="98" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="138" y="58" width="114" height="98" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="568" y="58" width="134" height="98" as="geometry"/></mxCell>
