        <mxCell id="c60" value="None recorded in Manufacturing in any year" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="534" y="377" width="326" height="34" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;i&gt;Every record that agrees with the hours comes from the time clock. The three records outside it (the capacity plan, the calendar and the output) do not support the hours as recorded, and absences are silent: the hours are unsupported, not unworked. Output is from Requirement 3&#x27;s weekly comparison.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="417" width="860" height="38" as="geometry"/></mxCell>
