        <mxCell id="c111" value="&lt;b&gt;Compare hours with output on work dates&lt;/b&gt;, counting output only up to the last day with time records. &lt;b&gt;Measure cost on the ledger&lt;/b&gt;, by pay date: never divide the cost of a pay year by the hours of a work year." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="176" y="282" width="684" height="44" as="geometry"/></mxCell>
