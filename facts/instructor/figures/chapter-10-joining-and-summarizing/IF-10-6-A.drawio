        <mxCell id="c37" value="Execution finished without errors.&lt;br&gt;Result: 1 rows returned&lt;br&gt;At line 45:&lt;br&gt;SELECT COUNT(*) AS JoinedRows" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="388" width="860" height="84" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;i&gt;Outlined: 152,880 rows, which is 390 invoices times 392 payments of supplier 1: the two tables share only SupplierID, so every invoice meets every payment. Summing GrandTotal over this join gives $147,941,203.76 where the invoices total $377,401.03. Total each table on its own, then join the totals.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="860" height="42" as="geometry"/></mxCell>
