        <mxCell id="c73" value="Execution finished without errors.&lt;br&gt;Result: 3 rows returned&lt;br&gt;At line 86:&lt;br&gt;SELECT si.InvoiceNumber, si.InvoiceDate, gl.PostingDate," style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="596" width="860" height="84" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;i&gt;Outlined: InvoiceDate. All three invoices are dated before the year, &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-11-29&lt;/span&gt; to &lt;span style=&quot;white-space:nowrap&quot;&gt;2025-12-04&lt;/span&gt;, and all post on &lt;span style=&quot;white-space:nowrap&quot;&gt;2026-01-01&lt;/span&gt;, so the ledger counts their $4,582.37 in the year and the invoice lines, selected by InvoiceDate, count it in the year before. The three amounts add up to the difference of the previous figure; Exercises&amp;nbsp;5.2 and 6.1 decide, from the shipments, which side is right.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="688" width="860" height="57" as="geometry"/></mxCell>
