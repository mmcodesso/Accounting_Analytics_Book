<mxfile host="Electron" version="29.6.6">
  <diagram name="Choosing the Join or the Summary" id="IF-10-0-A">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="534" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="534" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;A question about two or more tables&lt;/b&gt;&lt;br&gt;What should the result hold?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="150" height="431" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Only the rows that match in both tables&lt;/b&gt;&lt;br&gt;Each close with its work order and item" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="0" width="220" height="89" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;INNER JOIN on the logical key&lt;/b&gt;&lt;br&gt;For the ledger, name SourceDocumentType and SourceDocumentID in ON.&lt;br&gt;&lt;b&gt;Row-count test:&lt;/b&gt; the join returns as many rows as the child table: 12,998 closes after each join, 27,933 invoice lines in Exercise 10.1.&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;10.1, Steps&amp;nbsp;1&amp;nbsp;and&amp;nbsp;2; Exercises&amp;nbsp;10.1&amp;nbsp;(1)&amp;nbsp;and&amp;nbsp;10.2&amp;nbsp;(1)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="0" width="430" height="89" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.103248;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Every row of the first table, matched or not&lt;/b&gt;&lt;br&gt;Every manufactured item, with its closes if it has any" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="99" width="220" height="104" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;LEFT JOIN&lt;/b&gt;&lt;br&gt;A condition on the second table goes in ON; in WHERE it turns the join back into an inner join.&lt;br&gt;&lt;b&gt;Row-count test:&lt;/b&gt; the rows equal the first table&#x27;s: 88 items with the date in ON, 83 with it in WHERE.&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;10.1, Step&amp;nbsp;6&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="99" width="430" height="104" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.350348;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="&lt;b&gt;Only the rows of the first table that match nothing&lt;/b&gt;&lt;br&gt;Ledger rows with no payroll payment" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="213" width="220" height="104" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Anti-join: LEFT JOIN, then IS NULL on the second table&#x27;s key&lt;/b&gt;&lt;br&gt;Or NOT EXISTS. NOT IN returns 0 of 120 employees where NOT EXISTS finds 117, because the list holds a NULL.&lt;br&gt;&lt;b&gt;Row-count test:&lt;/b&gt; report the rows tested and the exceptions: 9,525 postings and none in Exercise 10.2, six in Exercise 10.5.&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;10.3, Step&amp;nbsp;7; Exercises&amp;nbsp;10.2&amp;nbsp;(3)&amp;nbsp;and&amp;nbsp;10.5&amp;nbsp;(2)&amp;nbsp;to&amp;nbsp;(5)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="213" width="430" height="104" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.614849;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="&lt;b&gt;One row per group: a total, a count or an average&lt;/b&gt;&lt;br&gt;The variance by item group and year" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="327" width="220" height="104" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;GROUP BY the key, and HAVING for a condition on the total&lt;/b&gt;&lt;br&gt;Group by the key, not the name.&lt;br&gt;&lt;b&gt;Row-count test:&lt;/b&gt; grouped by the key there are 211 customers, grouped by the name 210; and the groups add up to the control total, $2,265,636.88 of variance by item group, the ledger&#x27;s.&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;10.1, Steps&amp;nbsp;3&amp;nbsp;to&amp;nbsp;5; Exercises&amp;nbsp;10.1&amp;nbsp;(2)&amp;nbsp;and&amp;nbsp;10.3&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="327" width="430" height="104" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.87935;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=none;endArrow=blockThin;startFill=0;endFill=1;startSize=10;endSize=10;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=12;fontColor=#2C3E50;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Before any total over a join, ask at what level each amount is recorded.&lt;/b&gt; A header amount repeats on every line it is joined to: the year&#x27;s GrandTotal sums to $59,100,114.91 over the join of invoices to lines, against $31,919,124.42 from SalesInvoice alone, and supplier 1&#x27;s invoices joined to its payments return 152,880 rows. Sum the line&#x27;s own column, or total each table in a derived table before joining. &lt;i&gt;Practiced: Tutorial&amp;nbsp;10.3, Step&amp;nbsp;6; Exercise&amp;nbsp;10.6&amp;nbsp;(2).&lt;/i&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#FEF5E7;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="447" width="860" height="59" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A5D00;strokeColor=#8A5D00;strokeWidth=1;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="447" width="5" height="59" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;i&gt;Blue boxes ask the question; teal boxes give the join or summary that fits, the row-count test that checks it and where the chapter practices it.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="512" width="860" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
