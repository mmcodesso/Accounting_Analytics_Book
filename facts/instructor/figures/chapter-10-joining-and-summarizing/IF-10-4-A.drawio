        <mxCell id="c81" value="Execution finished without errors.&lt;br&gt;Result: 3 rows returned&lt;br&gt;At line 146:&lt;br&gt;SELECT SUBSTR(pi.InvoiceDate, 1, 4) AS InvoiceYear," style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="636" width="860" height="84" as="geometry"/></mxCell>
        <mxCell id="c83" value="&lt;i&gt;Outlined: VariancePct, 0.48%, 0.47% and 0.51%, a near-steady share of what is invoiced against orders while that amount grows 60% from 2024 to 2026. The variance grows with the amount invoiced. AmountInvoiced mixes quantity, order prices and mix, so the comparison cannot say how much of the growth is more buying. LineTotals differs from the amount by the rounding of each line.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="728" width="860" height="57" as="geometry"/></mxCell>
