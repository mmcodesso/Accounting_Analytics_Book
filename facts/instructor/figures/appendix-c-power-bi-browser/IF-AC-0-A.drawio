<mxfile host="Electron" version="29.6.6">
  <diagram name="Which Plan Fits the Class" id="IF-AC-0-A">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="501" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="501" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Start:&lt;/b&gt; can the student sign in at app.powerbi.com with a school account?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="c2" value="May the student edit semantic models and upload to OneDrive for work or school?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="128" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="Is there a Pro license?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="264" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Desktop, in a lab or on a Windows virtual machine&lt;/b&gt;&lt;br&gt;Tutorials: 13.1, 13.2 and 14.2 in Desktop take the place of C.1, C.2 and C.3.&lt;br&gt;Exercises: C.1 to C.3, worked in Desktop." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="372" y="0" width="488" height="66" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Plan C (60 minutes), or Desktop&lt;/b&gt;&lt;br&gt;The instructor shows C.1 Steps 1 to 4 and 7 to 9, the differences of C.2 (the card, the display units, the sort) and the measure and test of C.3.&lt;br&gt;Students: Exercises C.1 to C.3 in Desktop." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#8A5D00;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="372" y="112" width="488" height="82" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Plan A (180 minutes) or Plan B (75 minutes), with Exercise C.3 done by hand&lt;/b&gt;&lt;br&gt;Tutorials: C.1, C.2 and C.3.&lt;br&gt;Exercises: C.1 and C.2; C.3 Steps 2, 3 and 5, with the formula retyped and no version history." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="372" y="240" width="488" height="82" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Plan A (180 minutes) or Plan B (75 minutes), every step&lt;/b&gt;&lt;br&gt;Tutorials: C.1, C.2 and C.3.&lt;br&gt;Exercises: C.1 to C.3, with C.3&#x27;s &lt;i&gt;Save to version history&lt;/i&gt; and &lt;i&gt;Version history&lt;/i&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="372" y="368" width="488" height="66" as="geometry"/></mxCell>
