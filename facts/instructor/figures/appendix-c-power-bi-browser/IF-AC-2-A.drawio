        <mxCell id="c231" value="Each other segment&#x27;s largest month" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="608" width="203.712" height="20" as="geometry"/></mxCell>
