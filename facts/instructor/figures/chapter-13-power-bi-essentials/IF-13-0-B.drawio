        <mxCell id="c116" value="&lt;i&gt;InvoiceHeaders, the control table of Exercise 13.1: no relationship line touches it.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="92" y="424" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c117" value="&lt;b&gt;1&lt;/b&gt; the table that holds the key &amp;nbsp; &lt;b&gt;*&lt;/b&gt; the table that refers to it &amp;nbsp; &lt;b&gt;Arrow&lt;/b&gt; the direction in which a filter flows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2C3E50;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="546" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c118" value="&lt;i&gt;Each table lists its key columns and a few others; the model answer holds more. Outlined: InvoiceHeaders. PromotionProgram is the table Exercise 13.3 adds; after the tutorials the model has the other three relationships. Ex 13.5 Profile Figures holds the figures attached to Exercise 13.5&#x27;s memo and is related to nothing.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5D6D7E;fontStyle=0;fontFamily=Helvetica;spacing=2;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="572" width="860" height="53" as="geometry"/></mxCell>
        <mxCell id="c115" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B03A2E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="328" y="356" width="194" height="164" as="geometry"/></mxCell>
