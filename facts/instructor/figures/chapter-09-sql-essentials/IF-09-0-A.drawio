        <mxCell id="c19" value="&lt;b&gt;Blank cells&lt;/b&gt;&lt;br&gt;Where numbers belong" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="725" y="97" width="135" height="59" as="geometry"/></mxCell>
