<mxfile host="Electron" version="29.6.6">
  <diagram name="From a Wrong Result to Its Cause" id="IF-09-0-A">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="443" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="860" height="443" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;The query ran without an error. Is it the right query?&lt;/b&gt;&lt;br&gt;Compare the result with what it should be: the row count, the first rows, a control total. If it does not match, start from what the result shows." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="130" y="0" width="600" height="59" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;A comparison with NULL&lt;/b&gt;&lt;br&gt;ClosedDate = NULL returns 0 rows where 670 work orders are open&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; IS NULL&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;9.2, Step&amp;nbsp;6&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Text in the wrong case&lt;/b&gt;&lt;br&gt;&#x27;In progress&#x27; returns 0 rows&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; DISTINCT shows the stored text&lt;br&gt;&lt;i&gt;Practiced: Exercise&amp;nbsp;9.4, Steps&amp;nbsp;3&amp;nbsp;and&amp;nbsp;4&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="145" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;A text year compared with a number&lt;/b&gt;&lt;br&gt;A year from SUBSTR = 2026 keeps 0 of 670&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; quotes or CAST&lt;br&gt;&lt;i&gt;Practiced: Tutorial&amp;nbsp;9.2, Step&amp;nbsp;8&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;AND and OR without parentheses&lt;/b&gt;&lt;br&gt;The chapter&#x27;s example returns 319,667 rows, not the 16,413 intended&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; parentheses, then the row count&lt;br&gt;&lt;i&gt;Practiced: Exercise&amp;nbsp;9.1, Step&amp;nbsp;6; Exercise&amp;nbsp;9.6, Step&amp;nbsp;8&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="435" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;A missing comma&lt;/b&gt;&lt;br&gt;The second name becomes an alias&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; the headings: an alias, not a column&lt;br&gt;&lt;i&gt;Practiced: Question&amp;nbsp;11; Tutorial&amp;nbsp;9.3, Step&amp;nbsp;2&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;A NULL in a calculation&lt;/b&gt;&lt;br&gt;Dividing by zero hours gives NULL: 178 blank rates&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; COALESCE labels the NULL&lt;br&gt;&lt;i&gt;Practiced: Exercise&amp;nbsp;9.3, Step&amp;nbsp;5; Tutorial&amp;nbsp;9.2, Step&amp;nbsp;7&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="725" y="190" width="135" height="191" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;The result has no rows&lt;/b&gt;&lt;br&gt;The pane reports 0 rows returned" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1A5276;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="97" width="425" height="59" as="geometry"/></mxCell>
